@page "/home"
@using System.Security.Claims
@using XRayJournal.Core.Results
@rendermode InteractiveServer 
@inject XRayExamService XRayExamService

<AuthorizeView>
    <Authorized Context="authContext">
        <PageTitle>Home</PageTitle>

        <div class="alert alert-info mb-3">
            <a href="/logout" class="btn btn-sm btn-outline-secondary float-start me-3">Выйти</a>
            <i class="bi bi-person-circle me-1"></i>
            Вы авторизованы как: <strong>@authContext.User.Identity?.Name</strong>
        </div>

        <div class="container" style="margin-bottom:15px;">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <InputText @bind-Value="searchText" class="form-control"> </InputText>
                </div>
                <div class="col-auto">
                    <button @onclick="OnFilter">Поиск</button>
                </div>
                <div class="col-auto">
                    <InputSelect @bind-Value="searchSex" class="form-select">
                        <option value="">Все</option>
                        <option value="Муж">Муж</option>
                        <option value="Жен">Жен</option>
                    </InputSelect>
                </div>
                <div class="col-auto">
                    <button @onclick="ShowAddModal">Добавить пациента</button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">№ п/п</th>
                        <th scope="col">Фамилия</th>
                        <th scope="col">Имя</th>
                        <th scope="col">Отчество</th>
                        <th scope="col">Пол</th>
                        <th scope="col">Дата рождения</th>
                        <th scope="col">ID пациента</th>
                        <th scope="col">Исследование</th>
                        <th scope="col">Доза</th>
                        <th scope="col">Снимков/серий</th>
                        <th scope="col">Дата исс-я</th>
                        <th scope="col">Категория</th>
                        <th scope="col">Диагноз</th>
                        <th scope="col">Патология</th>
                        <th scope="col">Стоимость</th>
                        <th scope="col">Врач</th>
                        <th scope="col">Лаборант</th>
                        <th scope="col">Модальность</th>
                        <th scope="col">В операционной</th>
                        <th scope="col">Контраст</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in selectedPatients)
                    {

                        @if (patient.Exams?.Count > 0)
                        {
                            @foreach (var exam in patient.Exams)
                            {
                                var number = patient.Numbers?.FirstOrDefault(n => n.XRayDate == exam.XRayDate);
                                var displayNumber = number?.DisplayNumber ?? "-/-";
                                <tr @ondblclick="() => EditPatient(patient)">
                                    <td>@displayNumber</td>
                                    <td>@patient.SecondName</td>
                                    <td>@patient.FirstName</td>
                                    <td>@patient.ThirdName</td>
                                    <td>@patient.Sex</td>
                                    <td>@patient.BirthDate</td>
                                    <td>@patient.MedNumber</td>  
                                    <td>@(exam?.XRayName ?? "-")</td>
                                    <td>@(exam?.XRayDose.ToString() ?? "-")</td>
                                    <td>@(exam?.XRayShots.ToString() ?? "-")</td>
                                    <td>@(exam?.XRayDate.ToString() ?? "-")</td>
                                    <td>@(exam?.Category ?? "-")</td>
                                    <td>@(exam?.XRayDiagnose ?? "-")</td>
                                    <td>@GetPatologyDisplay(exam?.XRayPatology)</td>
                                    <td>@(exam?.XRayCost.ToString() ?? "-")</td>
                                    <td>@(exam?.Doctor ?? "-")</td>
                                    <td>@(exam?.Laborant ?? "-")</td>
                                    <td>@(exam?.XRayModality ?? "-")</td>
                                    <td>@GetInOperationDisplay(exam?.InOperation)</td>
                                    <td>@GetContrastDisplay(exam?.Contrast)</td>     
                                </tr>
                            }
                        }
                        else
                        {
                            <tr @ondblclick="() => EditPatient(patient)">
                                <td>-/-</td> @* ??? *@
                                <td>@patient.SecondName</td>
                                <td>@patient.FirstName</td>
                                <td>@patient.ThirdName</td>
                                <td>@patient.Sex</td>
                                <td>@patient.BirthDate</td>
                                <td>@patient.MedNumber</td>  
                                <td>-</td><td>-</td><td>-</td><td>-</td><td>-</td>
                                <td>-</td><td>-</td><td>-</td><td>-</td><td>-</td>
                                <td>-</td><td>-</td><td>-</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (showPatientModal)
        {
            <PatientEditModal Patient="editingPatient"
            OnSave="HandleSavePatient"
            OnCancel="HideModal"/>
        }
    </Authorized>
    <NotAuthorized>
        <div class="text-center mt-5">
            <div class="alert alert-warning">
                <h4>Требуется авторизация</h4>
                <p>Для доступа к системе необходимо войти в систему.</p>
                <a href="/login" class="btn btn-primary">Войти</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
@code{
    [Inject] 
    public PatientService PatientService { get; set; }

    [Inject]
    public NumberService NumberService { get; set; }

    private string searchText = "";
    private string searchSex = "";

    private List<PatientWithExamOutputModel> patients = new();

    private List<PatientWithExamOutputModel> selectedPatients = new();

    private bool showPatientModal = false;

    private PatientWithExamOutputModel? editingPatient = null;

    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    protected override void OnInitialized()
    {
        LoadPatients();
    }

    private void LoadPatients()
    {
        patients = PatientService.GetAllWithExams();

        selectedPatients = patients.ToList();
    }

    private void OnFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            selectedPatients = patients;
        }
        else
        {
            string tmp = searchText.Trim().ToLower();
            selectedPatients = patients.Where(p => 
                p.SecondName.ToLower().Contains(tmp) ||
                p.FirstName.ToLower().Contains(tmp) ||
                (p.ThirdName !=null && p.ThirdName.ToLower().Contains(tmp)) ||
                p.MedNumber.ToLower().Contains(tmp)
            ).ToList();
        }

        if (!string.IsNullOrEmpty(searchSex))
        {
            selectedPatients = selectedPatients.Where(p => p.Sex == searchSex).ToList();
        }

        StateHasChanged();
    }

    private void ShowAddModal()
    {
        editingPatient = null;
        showPatientModal = true;
    }

    private void EditPatient(PatientWithExamOutputModel patient)
    {
        editingPatient = patient;
        showPatientModal = true;
    }
    private void HideModal()
    {
        showPatientModal = false;
        editingPatient = null;
    }

    private async Task HandleSavePatient(PatientWithExamsInputModel formModel)
    {
        try
        {
            if (editingPatient == null) // новый пациент
            {
                var resultPatient = PatientService.Add(formModel.Patient);
                var newPatient = resultPatient.Data;
                DateOnly date = PatientService.GetPatientsLastExamDate(formModel.Patient.Id);

                var resultNumber = await NumberService.SaveNumberAsync(
                    newPatient.Id,
                    date, 
                    formModel.Number.YearlyNum,
                    formModel.Number.DailyNum
                );
                var newNumber = resultNumber.Data;

                var newPatientWithExams = new PatientWithExamOutputModel
                {
                    Id = newPatient.Id,
                    SecondName = newPatient.SecondName,
                    FirstName = newPatient.FirstName,
                    ThirdName = newPatient.ThirdName,
                    BirthDate = newPatient.BirthDate,
                    Sex = newPatient.Sex,
                    MedNumber = newPatient.MedNumber,
                    Exams = new List<XRayExamOutputModel>(),
                    Numbers = new List<NumberOutputModel>()
                };

                newPatientWithExams.Numbers.Add(new NumberOutputModel
                    {
                        Id = newNumber.Id,
                        YearlyNum = formModel.Number.YearlyNum,
                        DailyNum = formModel.Number.DailyNum,
                        XRayDate = today
                    });

                patients.Add(newPatientWithExams);
            }
            else //существующий пациент
            {
                formModel.Patient.Id = editingPatient.Id;
                var result = PatientService.Update(formModel.Patient);

                var existingPatient = patients.FirstOrDefault(p => p.Id == editingPatient.Id);

                var existingNumber = existingPatient?.Numbers?.FirstOrDefault(n => n.XRayDate == today);

                if(existingNumber != null) //если номер есть, обновляем
                {
                    existingNumber.YearlyNum = formModel.Number.YearlyNum;
                    existingNumber.DailyNum = formModel.Number.DailyNum;
                    await NumberService.UpdateNumberAsync(formModel.Number);//ошибка преобразования 
                }
                else
                {
                    DateOnly date = PatientService.GetPatientsLastExamDate(formModel.Patient.Id);//потанцевально ошибка null

                    var newNumber = await NumberService.SaveNumberAsync(
                        editingPatient.Id,
                        date,
                        formModel.Number.YearlyNum,
                        formModel.Number.DailyNum
                    );

                    if (existingPatient?.Numbers == null)
                    {
                        existingPatient.Numbers = new List<NumberOutputModel>();
                    }

                    existingPatient?.Numbers.Add(new NumberOutputModel
                    {
                        Id = newNumber.Data.Id,
                        YearlyNum = formModel.Number.YearlyNum,
                        DailyNum = formModel.Number.DailyNum,
                        XRayDate = date
                    });
                }
                

                var updatedPatient = result.Data;

                if(existingPatient != null)
                {
                    existingPatient.SecondName = updatedPatient.SecondName;
                    existingPatient.FirstName = updatedPatient.FirstName;
                    existingPatient.ThirdName = updatedPatient.ThirdName;
                    existingPatient.BirthDate = updatedPatient.BirthDate;
                    existingPatient.Sex = updatedPatient.Sex;
                    existingPatient.MedNumber = updatedPatient.MedNumber;
                }

            }

            LoadPatients();
            HideModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Исключение в HandleSavePatient: {ex}");
        }
    }

    private bool IsExamValid(XRayExamInputModel exam)
    {
        return !string.IsNullOrWhiteSpace(exam.XRayName) ||
            exam.XRayDose != 0 ||
            exam.XRayShots != 0 ||
            !string.IsNullOrWhiteSpace(exam.Category) ||
            !string.IsNullOrWhiteSpace(exam.XRayDiagnose);
    }
    private string GetPatologyDisplay(bool? patology)
    {
        return patology switch
        {
            true => "Да",
            false => "Нет",
            null => "Не указано"
        };
    }

    private string GetInOperationDisplay(bool? inOperation)
    {
        return inOperation switch
        {
            true => "Да",
            false => "Нет",
            null => "Не указано"
        };
    }

    private string GetContrastDisplay(bool? contrast)
    {
        return contrast switch
        {
            true => "Да",
            false => "Нет",
            null => "Не указано"
        };
    }

    private async Task HandlePatientDeleted(int patientId)
    {
        var patientToRemove = patients.FirstOrDefault(p => p.Id == patientId);

        if (patientToRemove != null)
        {
            patients.Remove(patientToRemove);
            selectedPatients.Remove(patientToRemove);
        }

        StateHasChanged();
    }

    private string GetRoleDisplayName(ClaimsPrincipal user)
    {
        var roleClaim = user.FindFirst(ClaimTypes.Name)?.Value;
        return roleClaim ?? "Неизвестно";
    }
} 