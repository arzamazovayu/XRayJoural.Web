<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@(Exam.Id == null ? "Новое исследование" : "Редактирование исследования")</h5>
    </div>
    <div class="card-body">
        <EditForm Model="Exam" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Название исследования *</label>
                        <InputText class="form-control" @bind-Value="Exam.XRayName" />
                        <ValidationMessage For="() => Exam.XRayName" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Доза (мЗв)</label>
                        <InputNumber class="form-control" @bind-Value="Exam.XRayDose" step="0.0001" min="0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Снимков/серий</label>
                        <InputNumber class="form-control" @bind-Value="Exam.XRayShots" min="0" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Дата исследования *</label>
                        <InputDate class="form-control" @bind-Value="Exam.XRayDate" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Категория *</label>
                        <InputSelect class="form-select" @bind-Value="Exam.Category">
                            <option value="Другое">Другое</option>
                            <option value="ОМС">ОМС</option>
                            <option value="ВМП ОМС">ВМП ОМС</option>
                            <option value="ДМС">ДМС</option>
                            <option value="ИД ФЛ">ИД ФЛ</option>
                            <option value="ИД ЮЛ">ИД ЮЛ</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Стоимость</label>
                        <InputNumber class="form-control" @bind-Value="Exam.XRayCost" min="0" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Диагноз</label>
                        <InputText class="form-control" @bind-Value="Exam.XRayDiagnose" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Модальность</label>
                        <InputSelect class="form-control" @bind-Value="Exam.XRayModality">
                            <option value="Цифровая рентгенография">Цифровая рентгенография</option>
                            <option value="Аналоговая рентгенография">Аналоговая рентгенография</option>
                            <option value="Рентгеноскопия">Рентгеноскопия</option>
                            <option value="Флюорография">Флюорография</option>
                            <option value="КТ">КТ</option>
                            <option value="МРТ">МРТ</option>
                            <option value="УЗИ">УЗИ</option>
                            <option value="Маммография">Маммография</option>
                            <option value="ПЭТ КТ">ПЭТ КТ</option>
                            <option value="Сцинтиграфия">Сцинтиграфия</option>
                            <option value="Другое">Другое</option>
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Врач</label>
                        <InputText class="form-control" @bind-Value="Exam.Doctor" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Лаборант</label>
                        <InputText class="form-control" @bind-Value="Exam.Laborant" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input" @bind-Value="Exam.XRayPatology" />
                            <label class="form-check-label">Патология</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="Exam.InOperation" />
                            <label class="form-check-label">В операционной</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="Exam.Contrast" />
                            <label class="form-check-label">Контраст</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">Отмена</button>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public XRayExamInputModel Exam { get; set; } = new XRayExamInputModel();

    [Parameter]
    public EventCallback<XRayExamInputModel> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Exam);
    }
}