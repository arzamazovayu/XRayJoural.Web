@using XRayJournal.Core.Results
@using XRayJournal.Web.Components

<div class="modal show d-block fade" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>


            <div class="modal-body">
                <!-- Вкладки -->
                <ul class="nav nav-tabs" id="patientTabs">
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "patient" ? "active" : "")" 
                        @onclick="SwitchToPatientTab" style="cursor: pointer;">Данные пациента</a>
                    </li>
                    @{
                        var isExamsEnabled = Patient?.Id > 0;
                        var examsCount = Patient?.Exams?.Count ?? 0;
                    }
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "exams" ? "active" : "") @(!isExamsEnabled ? "disabled" : "")" 
                        @onclick="@(() => { if (isExamsEnabled) activeTab = "exams";})" 
                        style="cursor: @(isExamsEnabled ? "pointer" : "not-allowed")">
                            Исследования
                            @if (examsCount > 0)
                            {
                                <span class="badge bg-secondary ms-1">@examsCount</span>
                            }
                        </a>
                    </li>
                </ul>

                <div class="tab-content mt-3">
                    <!-- Вкладка данных пациента -->
                    @if (activeTab == "patient")
                    {
                        <div class="tab-pane fade show active">
                            <EditForm Model="FormModel.Patient" OnValidSubmit="HandleSavePatient" FormName="TableForm">
                                <DataAnnotationsValidator />
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">№ п/п *</label>
                                            <div class="input-group">
                                                <InputNumber class="form-control" 
                                                @bind-Value="FormModel.Number.YearlyNum" 
                                                min="1" />
                                                <span class="input-group-text">/</span>
                                                <InputNumber class="form-control" 
                                                @bind-Value="FormModel.Number.DailyNum" 
                                                min="1" />
                                            </div>
                                            <ValidationMessage For="() => FormModel.Number.YearlyNum" />
                                            <ValidationMessage For="() => FormModel.Number.DailyNum" />

                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Фамилия *</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.SecondName" />
                                            <ValidationMessage For="() => FormModel.Patient.SecondName" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Имя *</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.FirstName" />
                                            <ValidationMessage For="() => FormModel.Patient.FirstName" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Отчество</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.ThirdName" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Дата рождения *</label>
                                            <InputDate class="form-control" @bind-Value="FormModel.Patient.BirthDate" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Пол *</label>
                                            <InputSelect class="form-select" @bind-Value="FormModel.Patient.Sex">
                                                <option value="Иное">Не определён</option>
                                                <option value="Муж">Муж</option>
                                                <option value="Жен">Жен</option>
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Номер карты *</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.MedNumber" />
                                            <ValidationMessage For="() => FormModel.Patient.MedNumber" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-4">
                                    <div class="col-md-6 d-flex gap-2">
                                        <!-- Кнопка сохранения пациента -->
                                        <button type="submit" class="btn btn-outline-success" >
                                            <i class="bi bi-save"></i> 
                                            @(Patient == null ? "Добавить пациента" : "Обновить пациента")
                                        </button>
                                        <!-- Кнопка удаления пациента -->
                                        @if (Patient != null && Patient.Id > 0)
                                        {
                                            <AuthorizeView Roles="Doctor">
                                                <Authorized Context="Doctor">
                                                    <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    @onclick="ShowDeletePatientModal">
                                                        <i class="bi bi-trash"></i>Удалить пациента
                                                    </button>
                                                </Authorized>
                                                <NotAuthorized Context ="Laborant"></NotAuthorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    }

                    <!-- Вкладка исследований -->
                    @if (activeTab == "exams")
                    {
                        <div class="tab-pane fade show active">
                            <!-- Список существующих исследований -->
                            @if (Patient?.Exams?.Count > 0)
                            {
                                <div class="mb-4">
                                    <h6>Существующие исследования:</h6>
                                    @foreach (var exam in Patient.Exams)
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body py-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong>@exam.XRayName</strong> 
                                                        <small class="text-muted ms-2">@exam.XRayDate.ToString("dd.MM.yyyy")</small>
                                                        <br/>
                                                        <small>Категория: @exam.Category | Снимков: @exam.XRayShots | 
                                                            Доза: @exam.XRayDose мЗв</small>
                                                    </div>
                                                    <div>
                                                        <button type="button" class="btn btn-sm btn-outline-primary me-2" 
                                                        @onclick="() => EditExistingExam(exam)">
                                                            Редактировать
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                        @onclick="() => ConfirmDeleteExam(exam)">
                                                            Удалить
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> 
                                    У пациента пока нет исследований. Добавьте первое исследование.
                                </div>
                            }

                            <!-- Форма для нового/редактируемого исследования -->
                            @if (showExamForm)
                            {
                                <div class="mb-4">
                                    <ExamForm Exam="currentExam" 
                                    OnSave="HandleExamSave" 
                                    OnCancel="CancelExamEdit" />
                                </div>
                            }

                            <!-- Кнопка добавления нового исследования -->
                            @if (!showExamForm)
                            {
                                <button type="button" class="btn btn-outline-primary" @onclick="AddNewExam">
                                    Добавить новое исследование
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
            </div>
        </div>
    </div>
    @if (showDeleteDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Подтверждение удаления</h5>
                        <button type="button" class="btn-close" @onclick="CancelDeleteExam"></button>
                    </div>
                    <div class="modal-body">
                        <p>@deleteDialogMessage</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeleteExam">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteExamConfirmed">Удалить</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showDeletePatientDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">
                            <i class="bi bi-exclamation-triangle"></i> Подтверждение удаления пациента
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDeletePatient"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <h6>Внимание! Это действие нельзя отменить.</h6>
                            <p>Будут удалены:</p>
                            <ul>
                                <li>Пациент: <strong>@Patient.SecondName @Patient.FirstName @Patient?.ThirdName</strong></li>
                                <li>Номер карты: <strong>@Patient.MedNumber</strong></li>
                                <li>Все связанные исследования: <strong>@Patient?.Exams?.Count</strong></li>
                            </ul>
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="confirmPatientDelete" />
                            <label class="form-check-label">
                                Я подтверждаю удаление пациента и всех связанных данных
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeletePatient">Отмена</button>
                        <button type="button" 
                        class="btn btn-danger" 
                        @onclick="DeletePatientConfirmed"
                        disabled="@(!confirmPatientDelete)">
                            <i class="bi bi-trash"></i> Удалить пациента
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    @inject XRayExamService XRayExamService
    @inject PatientService PatientService
    @inject NavigationManager NavigationManager
    @inject NumberService NumberService

    [Parameter]
    public PatientWithExamOutputModel? Patient { get; set; }

    [Parameter]
    public EventCallback<PatientWithExamsInputModel> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<int> OnPatientDeleted { get; set; }

    [Parameter]
    public NumberOutputModel? Number { get; set; }

    [Parameter]
    public DateOnly? SelectedExamDate { get; set; }

    private PatientWithExamsInputModel FormModel { get; set; } = new PatientWithExamsInputModel();
    private string activeTab = "patient";

    // Поля для управления формой исследования
    private bool showExamForm = false;
    private XRayExamInputModel currentExam = new XRayExamInputModel();

    // Поля для диалога удаления
    private bool showDeleteDialog = false;
    private string deleteDialogMessage = "";
    private XRayExamOutputModel examToDelete;

    // Поля для диалога удаления пациента
    private bool showDeletePatientDialog = false;
    private bool confirmPatientDelete = false;

    //Поле сегодняшней даты
    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);


    private string Title => Patient == null ? "Добавить пациента" : "Редактировать пациента";

    protected override async Task OnInitializedAsync()
    {
        DateOnly lastDate;

        if (Patient == null)
        {
            // Режим добавления нового пациента
            FormModel.Patient = new PatientInputModel
                {
                    Sex = "Иное",
                    BirthDate = today
                };
            //подсказываем номер
            var recommendNumber = await NumberService.GetNextNumberHintAsync();
            FormModel.Number = new NumberInputModel
            {
                Id = 0,
                YearlyNum = recommendNumber.Yearly,
                DailyNum = recommendNumber.Daily,
                XRayDate = SelectedExamDate ?? today
            };
        }
        else
        {
            // Режим редактирования существующего пациента
            FormModel.Patient = new PatientInputModel
                {
                    Id = Patient.Id,
                    SecondName = Patient.SecondName,
                    FirstName = Patient.FirstName,
                    ThirdName = Patient.ThirdName,
                    BirthDate = Patient.BirthDate,
                    Sex = Patient.Sex,
                    MedNumber = Patient.MedNumber
                };

            if (SelectedExamDate.HasValue)
            {
                lastDate = SelectedExamDate.Value;
            }
            else
            {
                lastDate = Patient.Exams?.FirstOrDefault()?.XRayDate ?? today;
            }

            var currentNumber = Patient.Numbers?.FirstOrDefault(n => n.XRayDate == lastDate);

            if (currentNumber != null) //если номер есть, то предложить ему номер из базы
            {
                FormModel.Number = new NumberInputModel
                    {
                        Id = currentNumber.Id,
                        YearlyNum = currentNumber.YearlyNum,
                        DailyNum = currentNumber.DailyNum,
                        XRayDate = currentNumber.XRayDate
                    };
            }
            else
            {
                var recommendNumber = await NumberService.GetNextNumberHintAsync();
                FormModel.Number = new NumberInputModel
                    {
                        Id = 0, //вместо 0 создастся новый Id
                        YearlyNum = recommendNumber.Yearly,
                        DailyNum = recommendNumber.Daily
                    };
            }
        }
        await base.OnInitializedAsync();
    }

    private async Task CloseModal()
    {
        await OnCancel.InvokeAsync();
    }

    private void AddNewExam()
    {
        if (Patient == null || Patient.Id == 0)
        {
            return;
        }
        currentExam = new XRayExamInputModel
        {
            PatientId = Patient.Id,
            XRayDate = DateOnly.FromDateTime(DateTime.Now)
        };
        showExamForm = true;
    }

    private void EditExistingExam(XRayExamOutputModel exam)
    {
        currentExam = new XRayExamInputModel
            {
                Id = exam.Id,
                XRayName = exam.XRayName,
                XRayDose = exam.XRayDose,
                XRayShots = exam.XRayShots,
                XRayDate = exam.XRayDate,
                Category = exam.Category,
                XRayDiagnose = exam.XRayDiagnose,
                XRayPatology = exam.XRayPatology,
                XRayCost = exam.XRayCost,
                Doctor = exam.Doctor,
                Laborant = exam.Laborant,
                XRayModality = exam.XRayModality,
                InOperation = exam.InOperation,
                Contrast = exam.Contrast,
                PatientId = Patient?.Id ?? 0
            };
        showExamForm = true;
    }

    private void CancelExamEdit()
    {
        showExamForm = false;
        currentExam = new XRayExamInputModel();
        StateHasChanged();
    }

    private async Task HandleExamSave(XRayExamInputModel exam)
    {
        OperationResult<XRayExamOutputModel> result;

        // Обновляем список исследований пациента
        if (exam.Id.HasValue)
        {
            // Обновление существующего исследования
            result = XRayExamService.Update(exam);
            if (result.Success)
            {
                // Обновляем исследование в списке пациента
                if (Patient != null && Patient.Exams != null)
                {
                    var index = Patient.Exams.FindIndex(e => e.Id == exam.Id.Value);
                    if (index >= 0)
                    {
                        Patient.Exams[index] = result.Data;
                    }
                }
            }
        }
        else
        {
            // Добавление нового исследования
            result = XRayExamService.Add(exam);
            if (result.Success)
            {
                // Добавляем исследование в список пациента
                if (Patient != null)
                {
                    Patient.Exams ??= new List<XRayExamOutputModel>();
                    Patient.Exams.Add(result.Data);
                }
            }
        }
        showExamForm = false;
        currentExam = new XRayExamInputModel();
        StateHasChanged();
    }

    private void ConfirmDeleteExam(XRayExamOutputModel exam)
    {
        examToDelete = exam;
        deleteDialogMessage = $"Вы уверены, что хотите удалить исследование '{exam.XRayName}' от {exam.XRayDate.ToString("dd.MM.yyyy")}?";
        showDeleteDialog = true;
        StateHasChanged();
    }

    private void CancelDeleteExam()
    {
        showDeleteDialog = false;
        examToDelete = null;
        StateHasChanged();
    }

    private async Task DeleteExamConfirmed()
    {
        if (examToDelete == null)
        {
            Console.WriteLine("examToDelete is null!");
            return; 
        }
        try
        {
            var result = XRayExamService.Delete(examToDelete.Id);

            if (result.Success)
            {
                // Удаляем из локального списка
                if (Patient?.Exams != null)
                {
                    Patient.Exams.Remove(examToDelete);
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при удалении исследования: {ex.Message}");
        }
        finally
        {
            showDeleteDialog = false;
            examToDelete = null;
            StateHasChanged();
        }
    }

    private void ShowDeletePatientModal()
    {
        showDeletePatientDialog = true;
        confirmPatientDelete = false;
        StateHasChanged();
    }

    private void CancelDeletePatient()
    {
        showDeletePatientDialog = false;
        confirmPatientDelete = false;
        StateHasChanged();
    }

    private async Task DeletePatientConfirmed()
    {
        if (Patient == null || Patient.Id == 0) 
            return;

        var result = PatientService.Delete(Patient.Id);
        if (result.Success)
        {
            await OnPatientDeleted.InvokeAsync(Patient.Id);
            await CloseModal();
        }
        else
        {
            Console.WriteLine($"[ERROR] Ошибка при удалении пациента: {result.ErrorMessage}");
        }
    }

    private void SwitchToPatientTab()
    {
        activeTab = "patient";
        StateHasChanged();
    }

    private async Task HandleSavePatient()
    {
        await OnSave.InvokeAsync(new PatientWithExamsInputModel
        {
            Patient = FormModel.Patient,
            Number = FormModel.Number
        });

        // После успешного сохранения пациента, переключаемся на исследования
        activeTab = "exams";
        StateHasChanged();
    }
}

