@page "/change-password"
@using XRayJournal.Core.Models
@inject UserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Смена пароля</PageTitle>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Смена пароля</h3>
                </div>

                <div class="card-body">
                    <EditForm Model="ChangeModel" OnValidSubmit="HandleChangeAsync" FormName="ChangePasswordForm">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <InputText @bind-Value="ChangeModel.Login" class="form-control disabled" />
                            <ValidationMessage For="() => ChangeModel.Login" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Текущий пароль</label>
                            <InputText type="password" @bind-Value="ChangeModel.CurrentPassword" class="form-control" />
                            <ValidationMessage For="() => ChangeModel.CurrentPassword" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Новый пароль</label>
                            <InputText type="password" @bind-Value="ChangeModel.NewPassword" class="form-control" />
                            <ValidationMessage For="() => ChangeModel.NewPassword" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Подтверждение пароля</label>
                            <InputText type="password" @bind-Value="ChangeModel.ConfirmPassword" class="form-control" />
                            <ValidationMessage For="() => ChangeModel.ConfirmPassword" />
                        </div>
                        <button type="submit" class="btn btn-primary">Сменить пароль</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "Login")]
    public string Login { get; set; }

    private ChangePasswordModel ChangeModel = new();

    protected override void OnInitialized()
    {
        Console.WriteLine($"ChangePassword page initialized with login: {Login}");
        // Сохраняем логин из URL в модель формы
        if (!string.IsNullOrEmpty(Login))
        {
            ChangeModel.Login = Login;
        }
    }

    private async Task HandleChangeAsync()
    {
        Console.WriteLine("HandleChangeAsync is running");

        if (ChangeModel.NewPassword != ChangeModel.ConfirmPassword)
        {
            await JS.InvokeVoidAsync("alert", "Пароли не совпадают");
            return;
        }

        var result = await UserService.ChangePasswordAsync(ChangeModel.Login, ChangeModel.CurrentPassword, ChangeModel.NewPassword);

        if (result.Success)
        {
            await JS.InvokeVoidAsync("alert", "Пароль успешно изменён. Теперь войдите с новым паролем.");
            Navigation.NavigateTo("/home");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", result.ErrorMessage);
        }
    }

}
