@page "/users"
@using XRayJournal.Core.InputModels
@using XRayJournal.Core.OutputModels
@using XRayJournal.Core
@using System.Security.Claims
@rendermode InteractiveServer
@inject UserService UserService
@inject CabinetService CabinetService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Создание сотрудника</PageTitle>

<AuthorizeView Roles="Head" Context="authContext">
    <Authorized>
        @if (!isPasswordConfirmed)
        {
                <div class="container mt-5" style="max-width: 500px;">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Подтверждение личности</h5>
                        </div>
                        <div class="card-body">
                            <p>Для перехода к созданию сотрудника введите ваш текущий пароль:</p>
                            <div class="mb-3">
                                <input type="password" class="form-control" @bind="confirmPassword" />
                            </div>
                        @if (!string.IsNullOrEmpty(confirmError))
                        {
                                    <div class="alert alert-danger">@confirmError</div>
                        }
                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-secondary" @onclick="GoHome">На главную</button>
                                <button type="button" class="btn btn-primary" @onclick="ConfirmPasswordAsync">Продолжить</button>
                            </div>
                        </div>
                    </div>
                </div>
        }
        else
        {
                <div class="container mt-4" style="max-width: 800px;">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Создание аккаунта для нового сотрудника</h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-warning">
                                <strong>ВНИМАНИЕ!</strong> При создании аккаунта для нового сотрудника вы берёте ответственность 
                                за достоверность и корректность указываемых данных. Изменение данных аккаунта возможно только через 
                                Администратора.
                            </div>

                            <EditForm Model="Model" OnValidSubmit="HandleCreate" FormName="CreateUserForm">
                                <DataAnnotationsValidator />

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Фамилия *</label>
                                        <InputText class="form-control" @bind-Value="Model.SecondName" />
                                        <ValidationMessage For="() => Model.SecondName" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Имя *</label>
                                        <InputText class="form-control" @bind-Value="Model.FirstName" />
                                        <ValidationMessage For="() => Model.FirstName" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Отчество</label>
                                        <InputText class="form-control" @bind-Value="Model.ThirdName" />
                                        <ValidationMessage For="() => Model.ThirdName" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Логин *</label>
                                    <InputText class="form-control" @bind-Value="Model.Login" placeholder="familia.io" />
                                    <ValidationMessage For="() => Model.Login" />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Кабинет *</label>
                                        <InputSelect class="form-select" @bind-Value="Model.CabinetId">
                                            <option value="0">-- Выберите кабинет --</option>
                                        @foreach (var cab in cabinets)
                                        {
                                                    <option value="@cab.Id">@cab.CabNum — @cab.CabinetName</option>
                                        }
                                        </InputSelect>
                                        <ValidationMessage For="() => Model.CabinetId" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Должность *</label>
                                        <InputSelect class="form-select" @bind-Value="Model.Role">
                                            <option value="">-- Выберите должность --</option>
                                            <option value="@UserRole.Doctor">Врач</option>
                                            <option value="@UserRole.Laborant">Лаборант</option>
                                            <option value="@UserRole.Head">Заведующий отделением</option>
                                        </InputSelect>
                                        <ValidationMessage For="() => Model.Role" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-3">
                                    <button type="button" class="btn btn-secondary" @onclick="GoHome">На главную</button>
                                    <button type="submit" class="btn btn-success">Создать аккаунт</button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger text-center mt-5">
            <h4>Доступ запрещён</h4>
            <p>Эта страница доступна только заведующему отделением.</p>
            <a href="/home" class="btn btn-primary">На главную</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isPasswordConfirmed = false;

    private string confirmPassword = string.Empty;

    private string confirmError = string.Empty;

    private UserInputModel Model = new();

    private List<CabinetOutputModel> cabinets = new();

    protected override async Task OnInitializedAsync()
    {
        var cabinetsResult = await CabinetService.GetAllAsync();

        if (cabinetsResult.Success)
        {
            cabinets = cabinetsResult.Data;
        }
    }

    private async Task ConfirmPasswordAsync()
    {
        confirmError = string.Empty;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst("UserId");
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
        {
            confirmError = "Не удалось определить пользователя";
            return;
        }

        var userResult = await UserService.GetByIdAsync(userId);
        if (!userResult.Success || userResult.Data == null)
        {
            confirmError = "Пользователь не найден";
            return;
        }

        var authResult = await UserService.AuthenticateAsync(userResult.Data.Login, confirmPassword);
        if (!authResult.Success)
        {
            confirmError = "Неверный пароль";
            return;
        }

        isPasswordConfirmed = true;
        StateHasChanged();
    }

    private async Task HandleCreate()
    {
        var result = await UserService.CreateUserAsync(Model);

        if (result.Success)
        {
            await JS.InvokeVoidAsync("alert", "Аккаунт успешно создан. При первом входе сотрудник должен будет сменить пароль.");
            //Navigation.NavigateTo("/home");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", result.ErrorMessage);
        }
    }

    private void GoHome() => Navigation.NavigateTo("/home");
}