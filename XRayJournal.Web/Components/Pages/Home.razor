@page "/home"
@using XRayJournal.Core.Results
@using XRayJournal.Core.OutputModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject RecordService RecordService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserService UserService
@inject CabinetService CabinetService

<PageTitle>Журнал рентгенологических исследований</PageTitle>

<AuthorizeView>
    <Authorized>
        <nav class="navbar navbar-expand-md sticky-top bg-white border-bottom shadow-sm" 
        style="top: 0; z-index: 1000; padding: 0.3rem 1rem;">
            <div class="container-fluid">
                <div class="navbar-brand d-flex align-items-center">
                    <span class="btn btn-outline-dark me-2 disabled">@currentUserFIO
                        <span class="badge bg-dark me-2">@currentCabinetName</span>
                    </span>
                </div>

                <div class="d-none d-md-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center">
                        <label class="form-label me-2 mb-0 small">с</label>
                        <InputDate @bind-Value="filterStartDate" class="form-control form-control-sm" style="width: 110px;" />
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="form-label me-2 mb-0 small">по</label>
                        <InputDate @bind-Value="filterEndDate" class="form-control form-control-sm" style="width: 110px;" />
                    </div>
                    <div class="d-flex align-items-center">
                        <InputText @bind-Value="searchText" class="form-control form-control-sm me-2" placeholder="ФИО, № карты..." style="width: 180px;" />
                        <button class="btn btn-sm btn-primary ms-1" @onclick="ApplyFilters">
                            🔍
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-success me-2" @onclick="ShowAddRecordModal">
                        Добавить запись
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Меню
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" @onclick="GoReports">Отчёты</a></li>
                            <li><a class="dropdown-item" @onclick="ChangePassword">Сменить пароль</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/logout">Выйти</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
            
        <!-- Мобильные фильтры (отображаются только на маленьких экранах) -->
        <div class="d-md-none bg-light p-2 border-bottom">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="d-flex align-items-center">
                    <label class="form-label me-1 mb-0 small">с</label>
                    <InputDate @bind-Value="filterStartDate" class="form-control form-control-sm" style="width: 110px;" />
                </div>
                <div class="d-flex align-items-center">
                    <label class="form-label me-1 mb-0 small">по</label>
                    <InputDate @bind-Value="filterEndDate" class="form-control form-control-sm" style="width: 110px;" />
                </div>
                <div class="d-flex align-items-center flex-grow-1">
                    <InputText @bind-Value="searchText" class="form-control form-control-sm" placeholder="ФИО, № карты..." />
                    <button class="btn btn-sm btn-primary ms-1" @onclick="ApplyFilters">
                        🔍
                    </button>
                </div>
            </div>
        </div>

        <div class="container-fluid mt-2">
            @* Таблица записей *@
            <div class="table-responsive">
                <table class="table table-striped table-hover  table-bordered" style="top: 0; z-index: 900;">
                    <thead class="table-dark" style="top: 0; z-index: 900;">
                        <tr>
                            <th scope="col">№ п/п</th>
                            <th scope="col">Фамилия</th>
                            <th scope="col">Имя</th>
                            <th scope="col">Отчество</th>
                            <th scope="col">Дата рождения</th>
                            <th scope="col">Номер карты</th>
                            <th scope="col">Категория</th>
                            <th scope="col">Дата исс-я</th>
                            <th scope="col">Исследование</th>
                            <th scope="col">Снимков/серий</th>
                            <th scope="col">Доза</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Загрузка...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (records?.Items != null && records.Items.Any())
                        {
                            @foreach (var record in records.Items)
                            {
                                <tr @ondblclick="() => EditRecordAsync(record.Id)">
                                    <td>@record.DisplayNumber</td>
                                    <td>@record.SecondName</td>
                                    <td>@record.FirstName</td>
                                    <td>@(record.ThirdName ?? "-")</td>
                                    <td>@record.BirthDate.ToString("dd.MM.yyyy")</td>
                                    <td>@record.MedNumber</td> 
                                    <td>@(record.Category ?? "-")</td>
                                    <td>@(record.XRayDate.Value.ToString("dd.MM.yyyy") ?? "-")</td> 
                                    <td>@(record.XRayName ?? "-")</td>
                                    <td>@(record.XRayShots ?? 0)</td>
                                    <td>@(record.XRayDose ?? 0)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    Нет записей за выбранный период
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @* Пагинация *@
        @if (records != null && records.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item @(records.HasPreviousPage ? "" : "disabled")">
                        <button class="page-link" @onclick="() => GoToPageAsync(records.Page - 1)">Назад</button>
                    </li>
                    @for (int i = 1; i <= records.TotalPages; i++)
                    {
                        <li class="page-item @(i == records.Page ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPageAsync(i)">@i</button>
                        </li>
                    }
                    <li class="page-item @(records.HasNextPage ? "" : "disabled")">
                        <button class="page-link" @onclick="() => GoToPageAsync(records.Page + 1)">Вперёд</button>
                    </li>
                </ul>
            </nav>
        }

        @if (showRecordModal)
        {
            <RecordEditModal RecordId="@editingRecordId"
            CurrentCabinetId="@currentCabinetId"
            CurrentUserId="@currentUserId"
            OnSave="HandleSaveRecordAsync"
            OnCancel="HideRecordModal"/>
        }
    </Authorized>
    <NotAuthorized>
        <div class="text-center mt-5">
            <div class="alert alert-warning">
                <h4>Требуется авторизация</h4>
                <p>Для доступа к системе необходимо войти в систему.</p>
                <a href="/login" class="btn btn-primary">Войти</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
@code{

    private PagedResult<RecordNecessaryOutputModel>? records;
    private bool isLoading = false;
    private bool showRecordModal = false;
    private int? editingRecordId = null;

    //Фильтры
    private DateOnly filterStartDate = new(DateOnly.FromDateTime(DateTime.Now).Year,
                                       DateOnly.FromDateTime(DateTime.Now).Month, 1);
    private DateOnly filterEndDate = DateOnly.FromDateTime(DateTime.Now);

    private string searchText = "";
    private string searchSex = "";

    //Пагинация
    private int currentPage = 1;
    private const int pageSize = 50;

    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    //Пользователь
    private int currentCabinetId = 0;
    private int currentUserId = 0;
    private string currentUserFIO = string.Empty;
    private string currentCabinetName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        await LoadRecordsAsync();
    }

    private async Task LoadUserInfoAsync()
    {
        //Получение Id авторизованного пользователя
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = GetUserIdFromClaims(authState.User);

        var userResult = await UserService.GetByIdAsync(currentUserId); //Получение пользователя
        if (userResult.Success)
        {
            currentUserFIO = userResult.Data.FIOshort;
            currentCabinetId = await UserService.GetUserCabinetIdAsync(currentUserId);

            var cabinetResult = await CabinetService.GetByIdAsync(currentCabinetId);
            if (cabinetResult.Success)
            {
                currentCabinetName = cabinetResult.Data.CabNum;
            }
        }
    }

    private int GetUserIdFromClaims(ClaimsPrincipal user)
    {
        var customIdClaim = user.FindFirst("UserId");
        if (customIdClaim != null && int.TryParse(customIdClaim.Value, out int customId))
        {
            return customId;
        }
        return 0;
    }

    private async Task LoadRecordsAsync()
    {
        isLoading = true;
        StateHasChanged();

        var result = await RecordService.GetNecessaryRecordsPagedAsync(
            currentPage,
            pageSize,
            filterStartDate,
            filterEndDate,
            searchText,
            searchSex,
            currentCabinetId);

        if (result.Success)
        {
            records = result.Data;
        }
        else
        {
            Console.WriteLine($"Ошибка: {result.ErrorMessage}");
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadRecordsAsync();
        StateHasChanged();
    }

    private async Task ShowAddRecordModal()
    {
        editingRecordId = null;
        showRecordModal = true;
        StateHasChanged();
    }

    private async Task EditRecordAsync(int recordId)
    {
        editingRecordId = recordId;
        showRecordModal = true;
        StateHasChanged();
    }
    private void HideRecordModal()
    {
        showRecordModal = false;
        editingRecordId = null;
        StateHasChanged();
    }

    private async Task HandleSaveRecordAsync()
    {
        await LoadRecordsAsync();
        StateHasChanged();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > records?.TotalPages) return;
        currentPage = page;
        await LoadRecordsAsync();
        StateHasChanged();
    }

    private void GoReports() => Navigation.NavigateTo("/reports");

    private async Task ChangePassword() 
    {
        var user = await UserService.GetByIdAsync(currentUserId);
        var currentUserLogin = user.Data.Login;

        Navigation.NavigateTo($"/change-password?login={Uri.EscapeDataString(currentUserLogin)}"); 
    }

} 