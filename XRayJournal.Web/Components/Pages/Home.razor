@page "/home"
@using XRayJournal.Core.Results
@using XRayJournal.Core.OutputModels
@using System.Security.Claims
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject RecordService RecordService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserService UserService
@inject CabinetService CabinetService

<PageTitle>Журнал рентгенологических исследований</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="sticky-top bg-white pt-2" style="top: 0; z-index: 1000;">
            <div class="alert alert-info mb-3 d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-person-circle me-2"></i>
                    <strong>Вы авторизованы как:</strong> @currentUserFIO
                    <span class="mx-3">|</span>
                    <i class="bi bi-building me-2"></i>
                    <strong>Текущий кабинет:</strong> @currentCabinetName
                </div>
                <div>
                    <button class="btn btn-sm btn-outline-secondary me-2" @onclick="GoReports">
                                <i class="bi bi-house-door"></i> Отчёты
                    </button>
                    <a href="/logout" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-right"></i> Выйти
                    </a>
                </div>
            </div>
            @* Панель фильтров *@
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-auto">
                            <label class="form-label">Период с</label>
                        </div>
                        <div class="col-auto">
                            <InputDate @bind-Value="filterStartDate" class="form-control" style="width: 135px;"/>
                        </div>
                        <div class="col-auto">
                            <label class="form-label">по</label>
                        </div>
                        <div class="col-auto">
                            <InputDate @bind-Value="filterEndDate" class="form-control" style="width: 135px;" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Поиск</label>
                        </div>
                        <div class="col-auto">
                            <InputText @bind-Value="searchText" class="form-control" 
                            placeholder="Фамилия, имя, номер карты..." />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                                <i class="bi bi-search"></i> Поиск
                            </button>
                        </div>
                        @* Кнопка добавления *@
                        <div class="col-auto">
                            <button class="btn btn-success" @onclick="ShowAddRecordModal">
                                <i class="bi bi-plus-circle"></i> Добавить пациента
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <div class="container-fluid">
                @* Таблица записей *@
                <div class="table-responsive">
                    <table class="table table-striped table-hover  table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">№ п/п</th>
                                <th scope="col">Фамилия</th>
                                <th scope="col">Имя</th>
                                <th scope="col">Отчество</th>
                                <th scope="col">Дата рождения</th>
                                <th scope="col">Номер карты</th>
                                <th scope="col">Категория</th>
                                <th scope="col">Дата исс-я</th>
                                <th scope="col">Исследование</th>
                                <th scope="col">Снимков/серий</th>
                                <th scope="col">Доза</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="10" class="text-center">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Загрузка...</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (records?.Items != null && records.Items.Any())
                            {
                                @foreach (var record in records.Items)
                                {
                                    <tr @ondblclick="() => EditRecord(record.Id)">
                                        <td>@record.DisplayNumber</td>
                                        <td>@record.SecondName</td>
                                        <td>@record.FirstName</td>
                                        <td>@(record.ThirdName ?? "-")</td>
                                        <td>@record.BirthDate.ToString("dd.MM.yyyy")</td>
                                        <td>@record.MedNumber</td> 
                                        <td>@(record.Category ?? "-")</td>
                                        <td>@(record.XRayDate.Value.ToString("dd.MM.yyyy") ?? "-")</td> 
                                        <td>@(record.XRayName ?? "-")</td>
                                        <td>@(record.XRayShots ?? 0)</td>
                                        <td>@(record.XRayDose ?? 0)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted">
                                        Нет записей за выбранный период
                                    </td>
                                </tr>
                            }
                            
                        </tbody>
                    </table>
                </div>
            </div>


            @* Пагинация *@
            @if (records != null && records.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(records.HasPreviousPage ? "" : "disabled")">
                            <button class="page-link" @onclick="() => GoToPage(records.Page - 1)">Назад</button>
                        </li>
                        @for (int i = 1; i <= records.TotalPages; i++)
                        {
                            <li class="page-item @(i == records.Page ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                            </li>
                        }
                        <li class="page-item @(records.HasNextPage ? "" : "disabled")">
                            <button class="page-link" @onclick="() => GoToPage(records.Page + 1)">Вперёд</button>
                        </li>
                    </ul>
                </nav>
            }
        
        @if (showRecordModal)
        {
            <RecordEditModal RecordId="@editingRecordId"
            CurrentCabinetId="@currentCabinetId"
            CurrentUserId="@currentUserId"
            OnSave="HandleSaveRecord"
            OnCancel="HideRecordModal"/>
        }
    </Authorized>
    <NotAuthorized>
        <div class="text-center mt-5">
            <div class="alert alert-warning">
                <h4>Требуется авторизация</h4>
                <p>Для доступа к системе необходимо войти в систему.</p>
                <a href="/login" class="btn btn-primary">Войти</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
@code{

    private PagedResult<RecordNecessaryOutputModel>? records;
    private bool isLoading = false;
    private bool showRecordModal = false;
    private int? editingRecordId = null;

    //Фильтры
    private DateOnly filterStartDate = new(DateOnly.FromDateTime(DateTime.Now).Year,
                                       DateOnly.FromDateTime(DateTime.Now).Month, 1);
    private DateOnly filterEndDate = DateOnly.FromDateTime(DateTime.Now);

    private string searchText = "";
    private string searchSex = "";

    //Пагинация
    private int currentPage = 1;
    private const int pageSize = 50;

    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    //Пользователь
    private int currentCabinetId = 0;
    private int currentUserId = 0;
    private string currentUserFIO = string.Empty;
    private string currentCabinetName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
        await LoadRecords();
    }

    private async Task LoadUserInfo()
    {
        //Получение Id авторизованного пользователя
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = GetUserIdFromClaims(authState.User);

        var userResult = await UserService.GetByIdAsync(currentUserId); //Получение пользователя
        if (userResult.Success)
        {
            currentUserFIO = userResult.Data.FIO;
            //Получение кабинета
            currentCabinetId = await UserService.GetUserCabinetIdAsync(currentUserId);
            var cabinetResult = await CabinetService.GetByIdAsync(currentCabinetId);
            if (cabinetResult.Success)
            {
                currentCabinetName = cabinetResult.Data.CabinetName;
            }
        }
    }

    private int GetUserIdFromClaims(ClaimsPrincipal user)
    {
        var customIdClaim = user.FindFirst("UserId");
        if (customIdClaim != null && int.TryParse(customIdClaim.Value, out int customId))
        {
            return customId;
        }
        return 0; // Значение по умолчанию
    }

    private async Task LoadRecords()
    {
        isLoading = true;
        StateHasChanged();

        var result = await RecordService.GetNecessaryRecordsPagedAsync(
            currentPage,
            pageSize,
            filterStartDate,
            filterEndDate,
            searchText,
            searchSex,
            currentCabinetId);

        if (result.Success)
            {
                records = result.Data;
            }
        else
            {
                // Показать ошибку
                Console.WriteLine($"Ошибка: {result.ErrorMessage}");
            }

        isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadRecords();
        StateHasChanged();
    }

    private async Task ShowAddRecordModal()
    {
        editingRecordId = null;
        showRecordModal = true;
        StateHasChanged();
    }

    private async Task EditRecord(int recordId)
    {
        editingRecordId = recordId;
        showRecordModal = true;
        StateHasChanged();
    }
    private void HideRecordModal()
    {
        showRecordModal = false;
        editingRecordId = null;
        StateHasChanged();
    }

    private async Task HandleSaveRecord()
    {
        //HideRecordModal();
        await LoadRecords();
        StateHasChanged();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > records?.TotalPages) return;
        currentPage = page;
        await LoadRecords();
        StateHasChanged();
    }

    private void GoReports() => Navigation.NavigateTo("/reports");

} 