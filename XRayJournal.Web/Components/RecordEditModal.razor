    private async Task DeletePatientConfirmed()
    {
        if (_editingRecordId > 0)
        {
            var result = PatientService.Delete(_localPatient.Id);

            if (result.Success)
            {
                await JS.InvokeVoidAsync("alert", "Пациент удалён");
