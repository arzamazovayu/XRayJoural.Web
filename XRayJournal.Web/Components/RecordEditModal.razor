@using XRayJournal.Core.Results
@using XRayJournal.Core.InputModels
@using XRayJournal.Core.OutputModels
@using XRayJournal.Web.Components
@inject RecordService RecordService
@inject PatientService PatientService
@inject XRayExamService XRayExamService
@inject NumberService NumberService
@inject UserService UserService
@inject IJSRuntime JS

<div class="modal show d-block fade" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>


            <div class="modal-body">
                <!-- Вкладки -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(activeTab == "patient" ? "active" : "")" 
                        @onclick=@(() => activeTab = "patient")>
                            Данные пациента
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(activeTab == "exams" ? "active" : "")"
                        @onclick=@(() => activeTab = "exams")> 
                            Исследования
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3">
                    <!-- Вкладка данных пациента -->
                    @if (activeTab == "patient")
                    {
                        <div class="tab-pane fade show active">
                            <EditForm Model="_localPatient" OnValidSubmit="SavePatientLocal" FormName="PatientForm">
                                <DataAnnotationsValidator />
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Фамилия *</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.SecondName" />
                                            <ValidationMessage For="() => _localPatient.SecondName" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Имя *</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.FirstName" />
                                            <ValidationMessage For="() => _localPatient.FirstName" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Отчество</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.ThirdName" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">№ п/п</label>
                                            <div class="input-group">
                                                <InputNumber class="form-control" @bind-Value="_localNumber.YearlyNum" min="1" style="width: 35px;" />
                                                <span class="input-group-text">/</span>
                                                <InputNumber class="form-control" @bind-Value="_localNumber.DailyNum" min="1" style="width: 35px;" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Дата рождения *</label>
                                            <InputDate class="form-control" @bind-Value="_localPatient.BirthDate" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Пол *</label>
                                            <InputSelect class="form-select" @bind-Value="_localPatient.Sex">
                                                <option value="Иное">Не определён</option>
                                                <option value="Муж">Муж</option>
                                                <option value="Жен">Жен</option>
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Номер карты *</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.MedNumber" />
                                            <ValidationMessage For="() => _localPatient.MedNumber" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-6 d-flex gap-2">
                                        <!-- Кнопка поиска пациента -->
                                        <button type="button" class="btn btn-info" @onclick="SearchPatient">
                                            <i class="bi bi-search"></i> Найти пациента
                                        </button>
                                        <!-- Кнопка сохранения пациента -->
                                        <button type="submit" class="btn btn-outline-success" @onclick="ClickSave" disabled="@(!isFindClicked)">
                                            <i class="bi bi-save"></i> Сохранить данные
                                        </button>
                                        <!-- Кнопка удаления пациента -->
                                        @if (_editingRecordId > 0)
                                        {
                                            <AuthorizeView Roles="Doctor, Head">
                                                <Authorized Context="Doctor">
                                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                                    @onclick="ShowDeleteRecordModal">
                                                        <i class="bi bi-trash"></i>Удалить запись
                                                    </button>
                                                </Authorized>
                                                <NotAuthorized Context ="Laborant"></NotAuthorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </div>
                                @if (showPatientSelection && foundPatients.Any())
                                {
                                    <div class="alert alert-info mt-3">
                                        <strong>Найдено несколько пациентов. Выберите нужного:</strong>
                                        <select class="form-select mt-2" @onchange="OnPatientSelected">
                                            <option value="">-- Выберите пациента --</option>
                                                @foreach (var patient in foundPatients)
                                                {
                                                    <option value="@patient.Id">
                                                        @patient.SecondName @patient.FirstName @patient.ThirdName, @patient.BirthDate.ToString("dd.MM.yyyy"), №@patient.MedNumber
                                                    </option>
                                                }
                                        </select>
                                    </div>
                                }
                            </EditForm>
                        </div>
                    }

                    <!-- Вкладка исследований -->
                    @if (activeTab == "exams")
                    {
                        <!-- Список существующих исследований -->
                        @if (_localExams.Any())
                        {
                            <div class="mb-4">
                                <h6>Добавленные исследования:</h6>
                                @for (int i = 0; i < _localExams.Count; i++)
                                {
                                    var exam = _localExams[i];
                                    var index = i;
                                    <div class="card mb-2">
                                        <div class="card-body py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>@exam.XRayName</strong> 
                                                    <small class="text-muted ms-2">@exam.XRayDate.ToString("dd.MM.yyyy")</small>
                                                    <br/>
                                                    <small>Категория: @exam.Category | Снимков: @exam.XRayShots | 
                                                        Доза: @exam.XRayDose мЗв</small>
                                                </div>
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-outline-primary me-2" 
                                                    @onclick="() => EditExistingExam(index)">
                                                        Редактировать
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                У пациента пока нет исследований. Добавьте новое исследование.
                            </div>
                        }

                        <!-- Форма для нового/редактируемого исследования -->
                        @if (showExamForm)
                        {
                            <div class="border rounded p-3 mb-3 bg-light">
                                <h6>@(editingExamIndex != -1 ? "Редактирование исследования" : "Новое исследование")</h6>
                                <EditForm Model="_currentExam" OnValidSubmit="SaveExamLocal">
                                    <DataAnnotationsValidator />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Название исследования *</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.XRayName" />
                                                <ValidationMessage For="() => _currentExam.XRayName" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Дата исследования *</label>
                                                <InputDate class="form-control" @bind-Value="_currentExam.XRayDate" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Категория *</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.Category">
                                                    <option value="Другое">Другое</option>
                                                    <option value="ОМС">ОМС</option>
                                                    <option value="ВМП ОМС">ВМП ОМС</option>
                                                    <option value="ДМС">ДМС</option>
                                                    <option value="ИД ФЛ">ИД ФЛ</option>
                                                    <option value="ИД ЮЛ">ИД ЮЛ</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Снимков/серий</label>
                                                <InputNumber class="form-control" @bind-Value="_currentExam.XRayShots" min="0" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Доза (мЗв)</label>
                                                <InputNumber class="form-control" @bind-Value="_currentExam.XRayDose" step="0.0001" min="0" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Модальность</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.XRayModality">
                                                    <option value="">-- Выберите --</option>
                                                    <option value="Цифровая рентгенография">Цифровая рентгенография</option>
                                                    <option value="Флюорография">Флюорография</option>
                                                    <option value="КТ">КТ</option>
                                                    <option value="МРТ">МРТ</option>
                                                    <option value="УЗИ">УЗИ</option>
                                                    <option value="Рентгеноскопия">Рентгеноскопия</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Стоимость</label>
                                                <InputNumber class="form-control" @bind-Value="_currentExam.XRayCost" min="0" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Врач</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.Doctor" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Лаборант</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.Laborant" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Диагноз</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.XRayDiagnose" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="_currentExam.XRayPatology" />
                                                <label class="form-check-label">Патология</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="_currentExam.InOperation" />
                                                <label class="form-check-label">В операционной</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="_currentExam.Contrast" />
                                                <label class="form-check-label">Контраст</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Сторона</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.Side">
                                                    <option value="">-- Выберите --</option>
                                                    <option value="Правая">Правая</option>
                                                    <option value="Левая">Левая</option>
                                                    <option value="Нет">Нет</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Область исследования</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.Area">
                                                    <option value="">-- Выберите --</option>
                                                    <option value=10>Голова</option>
                                                    <option value=20>Шея</option>
                                                    <option value=30>Грудь</option>
                                                    <option value=40>Живот</option>
                                                    <option value=50>Конечности</option>
                                                    <option value=60>Таз</option>
                                                    <option value=70>Позвоночник</option>
                                                    <option value=80>Плод</option>
                                                    <option value=90>Всё тело</option>
                                                    <option value=0>Прочее</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <button type="button" class="btn btn-secondary" @onclick="CancelExamEdit">Отмена</button>
                                        <button type="submit" class="btn btn-primary" @onclick="ExamClose">Сохранить исследование</button>
                                    </div>
                                </EditForm>
                            </div>
                        }

                        <!-- Кнопка добавления нового исследования -->
                        @if (!showExamForm)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="AddNewExam">
                                <i class="bi bi-plus-circle"></i> 
                                Добавить новое исследование
                            </button>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                <button type="button" class="btn btn-success" @onclick="SaveRecordToDatabase" disabled="@isExamAdding">
                    @(_editingRecordId > 0 ? "Обновить запись" : "Создать запись")
                </button>
            </div>
        </div>
    </div>

    <!-- Диалог удаления записи -->
    @if (showDeleteRecordDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">
                            <i class="bi bi-exclamation-triangle"></i> Подтверждение удаления записи
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDeleteRecord"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <h6>Внимание! Это действие нельзя отменить.</h6>
                            <p>Запись будет удалена.</p>
                            <ul>
                                <li>У пациента: <strong>
                                        @_localPatient.SecondName 
                                        @_localPatient.FirstName 
                                        @_localPatient?.ThirdName
                                    </strong></li>
                                <li>Будет удалено исследование: <strong>@(_localExams.FirstOrDefault()?.XRayName ?? "-")</strong></li>
                            </ul>
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="confirmRecordDelete" />
                            <label class="form-check-label">
                                Я подтверждаю удаление записи и связанного исследования
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeleteRecord">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteRecordConfirmed" 
                        disabled="@(!confirmRecordDelete)">
                            <i class="bi bi-trash"></i> Удалить запись
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public int? RecordId { get; set; }

    [Parameter]
    public int CurrentCabinetId { get; set; }

    [Parameter]
    public int CurrentUserId { get; set; }

    private string activeTab = "patient";
    //Поле сегодняшней даты
    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    //Поля локальных данных
    private PatientInputModel _localPatient = new();
    private NumberInputModel _localNumber = new();
    private List<XRayExamInputModel> _localExams = new();
    private DateOnly _localDate = DateOnly.FromDateTime(DateTime.Now);
    private int _editingRecordId = 0;

    // Поля для управления формой исследования
    private bool showExamForm = false;
    private int editingExamIndex = -1;
    private XRayExamInputModel _currentExam = new ();

    // Поля для диалога удаления
    private bool showDeleteDialog = false;
    private string deleteDialogMessage = "";
    private int deleteExamIndex = -1;

    // Поля диалога удаления записи
    private bool showDeleteRecordDialog = false;
    private bool confirmRecordDelete = false;

    // Поля для диалога удаления пациента
    private bool showDeletePatientDialog = false;
    private bool confirmPatientDelete = false;

    //Поля для поиска пациента
    private bool searchMode = true;
    private List<PatientOutputModel> foundPatients = new();
    private PatientOutputModel? selectedPatient = null;
    private bool showPatientSelection = false;

    //Поля кнопок
    private bool isFindClicked = false;
    private bool isExamAdding = false;

    private string Title => _editingRecordId > 0 ? "Редактирование записи" : "Новая запись";

    protected override async Task OnInitializedAsync()
    {
        // Загрузка данных при редактировании
        if (RecordId.HasValue && RecordId.Value > 0)
        {
            await LoadRecordForEdit(RecordId.Value);
        }
        else
        {
            InitNewRecord();
        }
        await SuggestNumbers();
    }

    private void InitNewRecord()
    {
        _editingRecordId = 0;
        _localPatient = new PatientInputModel { BirthDate = today, Sex = "Иное" };
        _localNumber = new NumberInputModel();
        _localExams = new List<XRayExamInputModel>();
        _localDate = today;

        showPatientSelection = false;
    }

    private async Task SuggestNumbers()
    {
        if (CurrentCabinetId > 0 && _editingRecordId == 0)
        {
            var (yearly, daily) = await NumberService.CalculateNextNumberAsync(_localDate, CurrentCabinetId);

            // Предлагаем номера, только если они ещё не установлены
            if (_localNumber.YearlyNum == 0)
                _localNumber.YearlyNum = yearly;
            if (_localNumber.DailyNum == 0)
                _localNumber.DailyNum = daily;
        }
    }

    // Сохранение данных пациента локально
    private async Task SavePatientLocal()
    {
        // Валидация уже происходит через DataAnnotations
        if (string.IsNullOrWhiteSpace(_localPatient.SecondName) ||
            string.IsNullOrWhiteSpace(_localPatient.FirstName) ||
            string.IsNullOrWhiteSpace(_localPatient.MedNumber))
        {
            await JS.InvokeVoidAsync("alert", "Заполните обязательные поля");
            return;
        }
        // Переключаемся на вкладку исследований
        activeTab = "exams";
        StateHasChanged();
    }

    private async Task LoadRecordForEdit(int recordId)
    {
        var result = await RecordService.GetByIdAsync(recordId);
        if (!result.Success || result.Data == null)
        {
            await JS.InvokeVoidAsync("alert", "Не удалось загрузить запись");
            return;
        }
        var d = result.Data;
        _editingRecordId = d.Id;
        _localDate = d.Date;


        _localPatient = new PatientInputModel
            {
                Id = d.Patient.Id,
                SecondName = d.Patient.SecondName,
                FirstName = d.Patient.FirstName,
                ThirdName = d.Patient.ThirdName,
                BirthDate = d.Patient.BirthDate,
                Sex = d.Patient.Sex,
                MedNumber = d.Patient.MedNumber
            };

        _localNumber = new NumberInputModel
            {
                Id = d.Number.Id,
                YearlyNum = d.Number.YearlyNum,
                DailyNum = d.Number.DailyNum
            };

        if (d.Exam != null)
        {
            var examInput = new XRayExamInputModel
            {
                Id = d.Exam.Id,
                XRayName = d.Exam.XRayName,
                XRayDose = d.Exam.XRayDose,
                XRayShots = d.Exam.XRayShots,
                XRayDate = d.Exam.XRayDate,
                Category = d.Exam.Category,
                XRayDiagnose = d.Exam.XRayDiagnose,
                XRayPatology = d.Exam.XRayPatology,
                XRayCost = d.Exam.XRayCost,
                Doctor = d.Exam.Doctor,
                Laborant = d.Exam.Laborant,
                XRayModality = d.Exam.XRayModality,
                InOperation = d.Exam.InOperation,
                Contrast = d.Exam.Contrast,
                CabinetId = d.Exam.CabinetId,
                Side = d.Exam.Side,
                Area = d.Exam.Area
            };

            showPatientSelection = false;
            _localExams.Add(examInput);
        }
    }

    private async Task CloseModal()
    {
        // Сброс локальных данных
        _localPatient = new();
        _localNumber = new();
        _localExams = new();
        _editingRecordId = 0;
        showExamForm = false;

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task AddNewExam()
    {
        isExamAdding = true;

        editingExamIndex = -1;
        _currentExam = new XRayExamInputModel
            {
                Category = "Другое",
                CabinetId = CurrentCabinetId,
                XRayDate = _localDate
            };

        // Автозаполнение врача/лаборанта
        var user = await UserService.GetByIdAsync(CurrentUserId);
        if (user.Success && user.Data != null)
        {
            var fioShort = user.Data.FIOshort;
            if (user.Data.Role.ToString() == "Doctor")
            {
                _currentExam.Doctor = fioShort;
            }
            else if (user.Data.Role.ToString() == "Laborant")
            {
                _currentExam.Laborant = fioShort;
            }
        }
        showExamForm = true;
        StateHasChanged();
    }

    private void EditExistingExam(int index)
    {
        isExamAdding = true;
        
        editingExamIndex = index;

        var exam = _localExams[index];   
        
        _currentExam = new XRayExamInputModel
            {
                Id = exam.Id,
                XRayName = exam.XRayName,
                XRayDose = exam.XRayDose,
                XRayShots = exam.XRayShots,
                XRayDate = exam.XRayDate,
                Category = exam.Category,
                XRayDiagnose = exam.XRayDiagnose,
                XRayPatology = exam.XRayPatology,
                XRayCost = exam.XRayCost,
                Doctor = exam.Doctor,
                Laborant = exam.Laborant,
                XRayModality = exam.XRayModality,
                InOperation = exam.InOperation,
                Contrast = exam.Contrast,
                CabinetId = exam.CabinetId,
                Side = exam.Side,
                Area = exam.Area,
            };

        showExamForm = true;
        StateHasChanged();
    }

    private void CancelExamEdit()
    {
        showExamForm = false;
        _currentExam = new ();
        editingExamIndex = -1;
        isExamAdding = false;
        StateHasChanged();
    }

    private async Task SaveExamLocal()
    {

        // Валидация названия и категории
        if (string.IsNullOrWhiteSpace(_currentExam.XRayName) || string.IsNullOrWhiteSpace(_currentExam.Category))
        {
            await JS.InvokeVoidAsync("alert", "Заполните название и категорию исследования");
            return;
        }
        if (editingExamIndex >= 0)
        {
            // Обновление существующего
            _localExams[editingExamIndex] = _currentExam;
        }
        else
        {
            // Добавление нового
            _localExams.Add(_currentExam);
        }
        CancelExamEdit();
        StateHasChanged();
    }

    private async Task SaveRecordToDatabase()
    {
        try
        {
            // 1. Пациент
            int patientId = _localPatient.Id;
            if (patientId == 0)
            {
                var addPatient = PatientService.Add(_localPatient);
                if (!addPatient.Success)
                {
                    await JS.InvokeVoidAsync("alert", $"Ошибка сохранения пациента: {addPatient.ErrorMessage}");
                    return;
                }
                patientId = addPatient.Data.Id;
            }
            else
            {
                // Если редактируется существующий пациент, обновляем
                var updPatient = PatientService.Update(_localPatient);
                if (!updPatient.Success)
                {
                    await JS.InvokeVoidAsync("alert", $"Ошибка обновления пациента: {updPatient.ErrorMessage}");
                    return;
                }
            }

            // 2. Номер
            int numberId = _localNumber.Id;
            if (numberId == 0)
            {
                var createNumber = await NumberService.CreateNumberAsync(_localNumber, patientId, _localDate);

                if (!createNumber.Success)
                {
                    await JS.InvokeVoidAsync("alert", $"Ошибка сохранения номера: {createNumber.ErrorMessage}");
                    return;
                }
                numberId = createNumber.Data.Id;
            }
            else
            {
                // Обновление номера (если изменился)
                var updNumber = await NumberService.UpdateNumberAsync(_localNumber);

                if (!updNumber.Success)
                {
                    await JS.InvokeVoidAsync("alert", $"Ошибка обновления номера: {updNumber.ErrorMessage}");
                    return;
                }
            }

            // 3. Исследования и записи
            if (_editingRecordId == 0) //Новая запись
            {
                foreach (var exam in _localExams)
                {
                    int examId = exam.Id ?? 0;

                    if (examId == 0)
                    {
                        var addExam = XRayExamService.Add(exam);
                        if (!addExam.Success)
                        {
                            await JS.InvokeVoidAsync("alert", $"Ошибка сохранения исследования: {addExam.ErrorMessage}");
                            return;
                        }
                        examId = addExam.Data.Id;
                    }
                    else
                    {
                        var updExam = XRayExamService.Update(exam);
                        if (!updExam.Success)
                        {
                            await JS.InvokeVoidAsync("alert", $"Ошибка обновления исследования: {updExam.ErrorMessage}");
                            return;
                        }
                    }
                    // Создаём запись (одно исследование – одна запись)
                    var createRecord = await RecordService.CreateRecordForExamAsync(patientId, numberId, examId, CurrentUserId, _localDate);

                    if (!createRecord.Success)
                    {
                        await JS.InvokeVoidAsync("alert", $"Ошибка создания записи для исследования {exam.XRayName}: {createRecord.ErrorMessage}");
                        return;
                    }
                }
                if (!_localExams.Any())
                {
                    // Если нет исследований, создаём запись без ExamId
                    var createEmpty = await RecordService.CreateEmptyRecordAsync(patientId, numberId, CurrentUserId, _localDate);

                    if (!createEmpty.Success)
                    {
                        await JS.InvokeVoidAsync("alert", $"Ошибка создания записи без исследования: {createEmpty.ErrorMessage}");
                        return;
                    }
                }
            }
            else //Редактирование существующей записи
            {
                // Для каждого исследования обновляем его (оно уже имеет Id)
                foreach (var exam in _localExams)
                {
                    int examId = exam.Id ?? 0;
                    if (examId == 0)
                    {
                        var addExam = XRayExamService.Add(exam);
                        if (!addExam.Success)
                        {
                            await JS.InvokeVoidAsync("alert", $"Ошибка обновления исследования: {addExam.ErrorMessage}");
                            return;
                        }
                        examId = addExam.Data.Id;
                        var createRecord = await RecordService.CreateRecordForExamAsync(patientId, numberId, examId, CurrentUserId, _localDate);
                        if (!createRecord.Success)
                        {
                            await JS.InvokeVoidAsync("alert", $"Ошибка создания записи для исследования {exam.XRayName}: {createRecord.ErrorMessage}");
                            return;
                        }
                    }
                    else
                    {
                        // Существующее исследование – обновляем его
                        var updExam = XRayExamService.Update(exam);
                        if (!updExam.Success)
                        {
                            await JS.InvokeVoidAsync("alert", $"Ошибка обновления исследования: {updExam.ErrorMessage}");
                            return;
                        }
                        // Запись уже существует, ничего не делаем
                    }
                }
            }

            await JS.InvokeVoidAsync("alert", "Запись успешно сохранена");
            if (OnSave.HasDelegate)
            {
                await OnSave.InvokeAsync();
            }
            await CloseModal();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private async Task SearchPatient()
    {
        isFindClicked = true;
        var search = new PatientSearchInputModel
            {
                SecondName = _localPatient.SecondName,
                FirstName = _localPatient.FirstName,
                ThirdName = _localPatient.ThirdName,
                BirthDate = _localPatient.BirthDate,
                MedNumber = _localPatient.MedNumber
            };
        var result = await PatientService.FindPatientsAsync(search);
        if (!result.Success)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка поиска: {result.ErrorMessage}");
            return;
        }
        foundPatients = result.Data;
        if (!foundPatients.Any())
        {
            await JS.InvokeVoidAsync("alert", "Пациент с такими данными не найден. Вы можете сохранить нового пациента.");
            return;
        }
        if (foundPatients.Count == 1)
        {
            SelectPatient(foundPatients.First()); // Один пациент найден, подгружаем его
        }
        else
        {
            showPatientSelection = true;   // Много пациентов найдено, показываем список выбора
            StateHasChanged();
        }
    }

    private void SelectPatient(PatientOutputModel patient)
    {
        _localPatient.Id = patient.Id;
        _localPatient.SecondName = patient.SecondName;
        _localPatient.FirstName = patient.FirstName;
        _localPatient.ThirdName = patient.ThirdName;
        _localPatient.BirthDate = patient.BirthDate;
        _localPatient.Sex = patient.Sex;
        _localPatient.MedNumber = patient.MedNumber;
        selectedPatient = patient;
        StateHasChanged();
    }

    private void ShowDeleteRecordModal()
    {
        showDeleteRecordDialog = true;
        confirmRecordDelete = false;
        StateHasChanged();
    }

    private void CancelDeleteRecord()
    {
        showDeleteRecordDialog = false;
        confirmRecordDelete = false;
        StateHasChanged();
    }

    private async Task DeleteRecordConfirmed()
    {
        try
        {
            // 1. Получаем информацию о записи
            var record = await RecordService.GetByIdAsync(_editingRecordId);

            if (!record.Success || record.Data == null)
            {
                await JS.InvokeVoidAsync("alert", "Не удалось загрузить запись для удаления");
                return;
            }

            int numberId = record.Data.Number.Id;
            int examId = record.Data.Exam?.Id ?? 0;

            // 2. Удаляем запись из Records
            var deleteRecord = await RecordService.DeleteRecordAsync(_editingRecordId);

            if (!deleteRecord.Success)
            {
                await JS.InvokeVoidAsync("alert", $"Ошибка удаления записи: {deleteRecord.ErrorMessage}");
                return;
            }

            // 3. Удаляем исследование (если оно есть)
            if (examId > 0)
            {
                var deleteExam = XRayExamService.Delete(examId);
                if (!deleteExam.Success)
                {
                    await JS.InvokeVoidAsync("alert", $"Ошибка удаления исследования: {deleteExam.ErrorMessage}");
                }
            }

            // 4. Проверяем, используется ли номер в других записях
            var otherRecords = await RecordService.GetRecordsByNumberIdAsync(numberId);

            if (otherRecords.Success && !otherRecords.Data.Any())
            {
                // Номер не используется, удаляем его
                var deleteNumber = await NumberService.DeleteNumberAsync(numberId);
                if (!deleteNumber.Success)
                {
                    await JS.InvokeVoidAsync("alert", $"Ошибка удаления номера: {deleteNumber.ErrorMessage}");
                }
            }

            await JS.InvokeVoidAsync("alert", "Запись успешно удалена");

            if (OnSave.HasDelegate)
            {
                await OnSave.InvokeAsync();
            }

            await CloseModal();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
        finally
        {
            CancelDeleteRecord();
        }
    }

    private void ClickSave()
    {
        isFindClicked = false;
    }

    private void ExamClose()
    {
        isExamAdding = false;
    }

    private void OnPatientSelected(ChangeEventArgs e)
    {
        var selectedId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedId) && int.TryParse(selectedId, out int id))
        {
            var patient = foundPatients.FirstOrDefault(p => p.Id == id);
            if (patient != null)
            {
                SelectPatient(patient);
                showPatientSelection = false;   // Скрываем список после выбора
            }
        }
    }
