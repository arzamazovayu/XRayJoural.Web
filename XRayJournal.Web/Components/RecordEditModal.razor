@using XRayJournal.Core.Results
@using XRayJournal.Core.InputModels
@using XRayJournal.Core.OutputModels
@using XRayJournal.Web.Components
@inject RecordService RecordService
@inject PatientService PatientService
@inject XRayExamService XRayExamService
@inject NumberService NumberService
@inject UserService UserService
@inject IJSRuntime JS

<div class="modal show d-block fade" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>


            <div class="modal-body">
                <!-- Вкладки -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(activeTab == "patient" ? "active" : "")" 
                        @onclick=@(() => activeTab = "patient")>
                            Данные пациента
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(activeTab == "exams" ? "active" : "")"
                        @onclick=@(() => activeTab = "exams")> 
                            Исследования
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3">
                    <!-- Вкладка данных пациента -->
                    @if (activeTab == "patient")
                    {
                        <div class="tab-pane fade show active">
                            <EditForm Model="_localPatient" OnValidSubmit="SavePatientLocal" FormName="PatientForm">
                                <DataAnnotationsValidator />
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">№ п/п</label>
                                            <div class="input-group">
                                                <InputNumber class="form-control" @bind-Value="_localNumber.YearlyNum" min="1" style="width: 45px;" />
                                                <span class="input-group-text">/</span>
                                                <InputNumber class="form-control" @bind-Value="_localNumber.DailyNum" min="1" style="width: 45px;" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Фамилия *</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.SecondName" />
                                            <ValidationMessage For="() => _localPatient.SecondName" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Имя *</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.FirstName" />
                                            <ValidationMessage For="() => _localPatient.FirstName" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Отчество</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.ThirdName" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Дата рождения *</label>
                                            <InputDate class="form-control" @bind-Value="_localPatient.BirthDate" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Пол *</label>
                                            <InputSelect class="form-select" @bind-Value="_localPatient.Sex">
                                                <option value="Иное">Не определён</option>
                                                <option value="Муж">Муж</option>
                                                <option value="Жен">Жен</option>
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label class="form-label">Номер карты *</label>
                                            <InputText class="form-control" @bind-Value="_localPatient.MedNumber" />
                                            <ValidationMessage For="() => _localPatient.MedNumber" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-6 d-flex gap-2">
                                        <!-- Кнопка поиска пациента -->
                                        <button type="button" class="btn btn-outline-info" @onclick="SearchPatient">
                                            <i class="bi bi-search"></i> Найти пациента
                                        </button>
                                        <!-- Кнопка сохранения пациента -->
                                        <button type="submit" class="btn btn-outline-success">
                                            <i class="bi bi-save"></i> Сохранить данные
                                        </button>
                                        <!-- Кнопка удаления пациента -->
                                        @if (_editingRecordId > 0)
                                        {
                                            <AuthorizeView Roles="Doctor">
                                                <Authorized Context="Doctor">
                                                    <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    @onclick="ShowDeletePatientModal">
                                                        <i class="bi bi-trash"></i>Удалить пациента
                                                    </button>
                                                </Authorized>
                                                <NotAuthorized Context ="Laborant"></NotAuthorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    }

                    <!-- Вкладка исследований -->
                    @if (activeTab == "exams")
                    {
                        <!-- Список существующих исследований -->
                        @if (_localExams.Any())
                        {
                            <div class="mb-4">
                                <h6>Добавленные исследования:</h6>
                                @foreach (var exam in _localExams)
                                {
                                    <div class="card mb-2">
                                        <div class="card-body py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>@exam.XRayName</strong> 
                                                    <small class="text-muted ms-2">@exam.XRayDate.ToString("dd.MM.yyyy")</small>
                                                    <br/>
                                                    <small>Категория: @exam.Category | Снимков: @exam.XRayShots | 
                                                        Доза: @exam.XRayDose мЗв</small>
                                                </div>
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-outline-primary me-2" 
                                                    @onclick="() => EditExistingExam(exam)">
                                                        Редактировать
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    @onclick="() => ConfirmDeleteExam(exam)">
                                                        Удалить
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                У пациента пока нет исследований. Добавьте новое исследование.
                            </div>
                        }

                        <!-- Форма для нового/редактируемого исследования -->
                        @if (showExamForm)
                        {
                            <div class="border rounded p-3 mb-3 bg-light">
                                <h6>@(editingExamIndex != -1 ? "Редактирование исследования" : "Новое исследование")</h6>
                                <EditForm Model="_currentExam" OnValidSubmit="SaveExamLocal">
                                    <DataAnnotationsValidator />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Название исследования *</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.XRayName" />
                                                <ValidationMessage For="() => _currentExam.XRayName" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Дата исследования *</label>
                                                <InputDate class="form-control" @bind-Value="_currentExam.XRayDate" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Категория *</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.Category">
                                                    <option value="Другое">Другое</option>
                                                    <option value="ОМС">ОМС</option>
                                                    <option value="ВМП ОМС">ВМП ОМС</option>
                                                    <option value="ДМС">ДМС</option>
                                                    <option value="ИД ФЛ">ИД ФЛ</option>
                                                    <option value="ИД ЮЛ">ИД ЮЛ</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Снимков/серий</label>
                                                <InputNumber class="form-control" @bind-Value="_currentExam.XRayShots" min="0" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Доза (мЗв)</label>
                                                <InputNumber class="form-control" @bind-Value="_currentExam.XRayDose" step="0.001" min="0" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Модальность</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.XRayModality">
                                                    <option value="">-- Выберите --</option>
                                                    <option value="Цифровая рентгенография">Цифровая рентгенография</option>
                                                    <option value="Аналоговая рентгенография">Аналоговая рентгенография</option>
                                                    <option value="КТ">КТ</option>
                                                    <option value="МРТ">МРТ</option>
                                                    <option value="УЗИ">УЗИ</option>
                                                    <option value="Маммография">Маммография</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Стоимость</label>
                                                <InputNumber class="form-control" @bind-Value="_currentExam.XRayCost" min="0" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Врач</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.Doctor" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Лаборант</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.Laborant" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Диагноз</label>
                                                <InputText class="form-control" @bind-Value="_currentExam.XRayDiagnose" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="_currentExam.XRayPatology" />
                                                <label class="form-check-label">Патология</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="_currentExam.InOperation" />
                                                <label class="form-check-label">В операционной</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="_currentExam.Contrast" />
                                                <label class="form-check-label">Контраст</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Сторона</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.Side">
                                                    <option value="">-- Выберите --</option>
                                                    <option value="Правая">Правая</option>
                                                    <option value="Левая">Левая</option>
                                                    <option value="Нет">Нет</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Область исследования</label>
                                                <InputSelect class="form-select" @bind-Value="_currentExam.Area">
                                                    <option value="">-- Выберите --</option>
                                                    <option value=10>Голова</option>
                                                    <option value=20>Шея</option>
                                                    <option value=30>Грудь</option>
                                                    <option value=40>Живот</option>
                                                    <option value=50>Конечности</option>
                                                    <option value=60>Таз</option>
                                                    <option value=70>Позвоночник</option>
                                                    <option value=80>Плод</option>
                                                    <option value=90>Всё тело</option>
                                                    <option value=0>Прочее</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <button type="button" class="btn btn-secondary" @onclick="CancelExamEdit">Отмена</button>
                                        <button type="submit" class="btn btn-primary">Сохранить исследование</button>
                                    </div>
                                </EditForm>
                            </div>
                        }

                        <!-- Кнопка добавления нового исследования -->
                        @if (!showExamForm)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="AddNewExam">
                                <i class="bi bi-plus-circle"></i> 
                                Добавить новое исследование
                            </button>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                <button type="button" class="btn btn-success" @onclick="SaveRecordToDatabase">
                    Создать запись
                </button>
            </div>
        </div>
    </div>

    <!-- Диалог удаления исследования -->
    @if (showDeleteDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Подтверждение удаления</h5>
                        <button type="button" class="btn-close" @onclick="CancelDeleteExam"></button>
                    </div>
                    <div class="modal-body">
                        <p>@deleteDialogMessage</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeleteExam">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteExamConfirmed">Удалить</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Диалог удаления пациента -->
    @if (showDeletePatientDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">
                            <i class="bi bi-exclamation-triangle"></i> Подтверждение удаления пациента
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDeletePatient"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <h6>Внимание! Это действие нельзя отменить.</h6>
                            <p>Будут удалены:</p>
                            <ul>
                                <li>Пациент: <strong>
                                        @_localPatient.SecondName 
                                        @_localPatient.FirstName 
                                        @_localPatient?.ThirdName
                                    </strong></li>
                                <li>Номер карты: <strong>@_localPatient.MedNumber</strong></li>
                                <li>Все связанные исследования: <strong>@_localExams?.Count</strong></li>
                            </ul>
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="confirmPatientDelete" />
                            <label class="form-check-label">
                                Я подтверждаю удаление пациента и всех связанных данных
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeletePatient">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="DeletePatientConfirmed" 
                        disabled="@(!confirmPatientDelete)">
                            <i class="bi bi-trash"></i> Удалить пациента
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public int? RecordId { get; set; }

    [Parameter]
    public int CurrentCabinetId { get; set; }

    [Parameter]
    public int CurrentUserId { get; set; }

    private string activeTab = "patient";
    //Поле сегодняшней даты
    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    //Поля локальных данных
    private PatientInputModel _localPatient = new();
    private NumberInputModel _localNumber = new();
    private List<XRayExamInputModel> _localExams = new();
    private DateOnly _localDate = DateOnly.FromDateTime(DateTime.Now);
    private int _editingRecordId = 0;

    // Поля для управления формой исследования
    private bool showExamForm = false;
    private int editingExamIndex = -1;
    private XRayExamInputModel _currentExam = new ();

    // Поля для диалога удаления
    private bool showDeleteDialog = false;
    private string deleteDialogMessage = "";
    private int deleteExamIndex = -1;

    // Поля для диалога удаления пациента
    private bool showDeletePatientDialog = false;
    private bool confirmPatientDelete = false;

    //Поля для поиска пациента
    private bool searchMode = true;
    private List<PatientOutputModel> foundPatients = new();
    private PatientOutputModel? selectedPatient = null;

    private string Title => _editingRecordId > 0 ? "Редактирование записи" : "Новая запись";

    protected override async Task OnInitializedAsync()
    {
        // Загрузка данных при редактировании
        if (RecordId.HasValue && RecordId.Value > 0)
        {
            await LoadRecordForEdit(RecordId.Value);
        }
        else
        {
            InitNewRecord();
        }
        await SuggestNumbers();
    }

    private void InitNewRecord()
    {
        _editingRecordId = 0;
        _localPatient = new PatientInputModel { BirthDate = today, Sex = "Иное" };
        _localNumber = new NumberInputModel();
        _localExams = new List<XRayExamInputModel>();
        _localDate = today;
    }

    private async Task SuggestNumbers()
    {
        if (CurrentCabinetId > 0 && _editingRecordId == 0)
        {
            var (yearly, daily) = await NumberService.CalculateNextNumberAsync(_localDate, CurrentCabinetId);

            // Предлагаем номера, только если они ещё не установлены
            if (_localNumber.YearlyNum == 0)
                _localNumber.YearlyNum = yearly;
            if (_localNumber.DailyNum == 0)
                _localNumber.DailyNum = daily;
        }
    }

    // Сохранение данных пациента локально
    private async Task SavePatientLocal()
    {
        // Валидация уже происходит через DataAnnotations
        if (string.IsNullOrWhiteSpace(_localPatient.SecondName) ||
            string.IsNullOrWhiteSpace(_localPatient.FirstName) ||
            string.IsNullOrWhiteSpace(_localPatient.MedNumber))
        {
            await JS.InvokeVoidAsync("alert", "Заполните обязательные поля");
            return;
        }
        // Переключаемся на вкладку исследований
        activeTab = "exams";
        StateHasChanged();
    }

    private async Task LoadRecordForEdit(int recordId)
    {
        var result = await RecordService.GetByIdAsync(recordId);
        if (!result.Success || result.Data == null)
        {
            await JS.InvokeVoidAsync("alert", "Не удалось загрузить запись");
            return;
        }
        var d = result.Data;
        _editingRecordId = d.Id;
        _localDate = d.Date;


        _localPatient = new PatientInputModel
            {
                Id = d.Patient.Id,
                SecondName = d.Patient.SecondName,
                FirstName = d.Patient.FirstName,
                ThirdName = d.Patient.ThirdName,
                BirthDate = d.Patient.BirthDate,
                Sex = d.Patient.Sex,
                MedNumber = d.Patient.MedNumber
            };

        _localNumber = new NumberInputModel
            {
                Id = d.Number.Id,
                YearlyNum = d.Number.YearlyNum,
                DailyNum = d.Number.DailyNum
            };

        if (d.Exam != null)
        {
            var examInput = new XRayExamInputModel
            {
                Id = d.Exam.Id,
                XRayName = d.Exam.XRayName,
                XRayDose = d.Exam.XRayDose,
                XRayShots = d.Exam.XRayShots,
                XRayDate = d.Exam.XRayDate,
                Category = d.Exam.Category,
                XRayDiagnose = d.Exam.XRayDiagnose,
                XRayPatology = d.Exam.XRayPatology,
                XRayCost = d.Exam.XRayCost,
                Doctor = d.Exam.Doctor,
                Laborant = d.Exam.Laborant,
                XRayModality = d.Exam.XRayModality,
                InOperation = d.Exam.InOperation,
                Contrast = d.Exam.Contrast,
                CabinetId = d.Exam.CabinetId,
                Side = d.Exam.Side,
                Area = d.Exam.Area
            };
            _localExams.Add(examInput);
        }
    }

    private async Task CloseModal()
    {
        // Сброс локальных данных
        _localPatient = new();
        _localNumber = new();
        _localExams = new();
        _editingRecordId = 0;
        showExamForm = false;

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task AddNewExam()
    {
        editingExamIndex = -1;
        _currentExam = new XRayExamInputModel
            {
                Category = "Другое",
                CabinetId = CurrentCabinetId,
                XRayDate = _localDate
            };
        // Автозаполнение врача/лаборанта
        var user = await UserService.GetByIdAsync(CurrentUserId);
        if (user.Success && user.Data != null)
        {
            var fioShort = user.Data.FIOshort;
            if (user.Data.Role.ToString() == "Doctor")
                _currentExam.Doctor = fioShort;
            else if (user.Data.Role.ToString() == "Laborant")
                _currentExam.Laborant = fioShort;
        }
        showExamForm = true;
        StateHasChanged();
    }

    private void EditExistingExam(XRayExamInputModel exam)
    {

        editingExamIndex = _localExams.FindIndex(e => e == exam);

        _currentExam = new XRayExamInputModel();
        _currentExam.Id = exam.Id;
        _currentExam.XRayName = exam.XRayName;
        _currentExam.XRayDose = exam.XRayDose;
        _currentExam.XRayShots = exam.XRayShots;
        _currentExam.XRayDate = exam.XRayDate;
        _currentExam.Category = exam.Category;
        _currentExam.XRayDiagnose = exam.XRayDiagnose;
        _currentExam.XRayPatology = exam.XRayPatology;
        _currentExam.XRayCost = exam.XRayCost;
        _currentExam.Doctor = exam.Doctor;
        _currentExam.Laborant = exam.Laborant;
        _currentExam.XRayModality = exam.XRayModality;
        _currentExam.InOperation = exam.InOperation;
        _currentExam.Contrast = exam.Contrast;
        _currentExam.CabinetId = exam.CabinetId;
        _currentExam.Side = exam.Side;
        _currentExam.Area = exam.Area;        

        showExamForm = true;
        StateHasChanged();
    }

    private void CancelExamEdit()
    {
        showExamForm = false;
        _currentExam = new ();
        editingExamIndex = -1;
        StateHasChanged();
    }

    private async Task SaveExamLocal()
    {
        // Валидация названия и категории
        if (string.IsNullOrWhiteSpace(_currentExam.XRayName) || string.IsNullOrWhiteSpace(_currentExam.Category))
        {
            await JS.InvokeVoidAsync("alert", "Заполните название и категорию исследования");
            return;
        }
        if (editingExamIndex >= 0)
        {
            // Обновление существующего
            _localExams[editingExamIndex] = _currentExam;
        }
        else
        {
            // Добавление нового
            _localExams.Add(_currentExam);
        }
        CancelExamEdit();
        StateHasChanged();
    }

    private void ConfirmDeleteExam(XRayExamInputModel exam)
    {
        deleteExamIndex = _localExams.FindIndex(e => e == exam);
        if (deleteExamIndex >= 0)
        {
            deleteDialogMessage = $"Вы уверены, что хотите удалить исследование '{exam.XRayName}' от {exam.XRayDate.ToString("dd.MM.yyyy")}?";
            showDeleteDialog = true;
            StateHasChanged();
        }
    }

    private void CancelDeleteExam()
    {
        showDeleteDialog = false;
        deleteExamIndex = -1;
        StateHasChanged();
    }

    private async Task DeleteExamConfirmed()
    {
        if (deleteExamIndex >= 0 && deleteExamIndex < _localExams.Count)
        {
            _localExams.RemoveAt(deleteExamIndex);
            await JS.InvokeVoidAsync("alert", "Исследование удалено");
        }
        CancelDeleteExam();
        StateHasChanged();
    }

