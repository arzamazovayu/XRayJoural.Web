@using XRayJournal.Core.Results
@using XRayJournal.Core.InputModels
@using XRayJournal.Core.OutputModels
@using XRayJournal.Web.Components
@inject RecordService RecordService
@inject PatientService PatientService
@inject XRayExamService XRayExamService
@inject NumberService NumberService
@inject UserService UserService
@inject IJSRuntime JS

<div class="modal show d-block fade" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>


            <div class="modal-body">
                <!-- Вкладки -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(activeTab == "patient" ? "active" : "")" 
                        @onclick=@(() => activeTab = "patient")>
                            Данные пациента
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(activeTab == "exams" ? "active" : "")"
                        @onclick=@(() => activeTab = "exams")> 
                            Исследования
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3">
                    <!-- Вкладка данных пациента -->
                    @if (activeTab == "patient")
                    {
                        <div class="tab-pane fade show active">
                            <EditForm Model="FormModel.Patient" OnValidSubmit="SavePatientOnly" FormName="PatientForm">
                                <DataAnnotationsValidator />
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Фамилия *</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.SecondName" />
                                            <ValidationMessage For="() => FormModel.Patient.SecondName" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Имя *</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.FirstName" />
                                            <ValidationMessage For="() => FormModel.Patient.FirstName" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Отчество</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.ThirdName" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Дата рождения *</label>
                                            <InputDate class="form-control" @bind-Value="FormModel.Patient.BirthDate" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Пол *</label>
                                            <InputSelect class="form-select" @bind-Value="FormModel.Patient.Sex">
                                                <option value="Иное">Не определён</option>
                                                <option value="Муж">Муж</option>
                                                <option value="Жен">Жен</option>
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Номер карты *</label>
                                            <InputText class="form-control" @bind-Value="FormModel.Patient.MedNumber" />
                                            <ValidationMessage For="() => FormModel.Patient.MedNumber" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-6 d-flex gap-2">
                                        <!-- Кнопка сохранения пациента -->
                                        <button type="submit" class="btn btn-outline-success" >
                                            <i class="bi bi-save"></i> 
                                            Добавить пациента
                                        </button>
                                        <!-- Кнопка удаления пациента -->
                                        @if (existingPatientId > 0)
                                        {
                                            <AuthorizeView Roles="Doctor">
                                                <Authorized Context="Doctor">
                                                    <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    @onclick="ShowDeletePatientModal">
                                                        <i class="bi bi-trash"></i>Удалить пациента
                                                    </button>
                                                </Authorized>
                                                <NotAuthorized Context ="Laborant"></NotAuthorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    }

                    <!-- Вкладка исследований -->
                    @if (activeTab == "exams")
                    {
                        <!-- Список существующих исследований -->
                        @if (existingExams != null && existingExams.Any())
                        {
                            <div class="mb-4">
                                <h6>Существующие исследования:</h6>
                                @foreach (var exam in existingExams)
                                {
                                    <div class="card mb-2">
                                        <div class="card-body py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>@exam.XRayName</strong> 
                                                    <small class="text-muted ms-2">@exam.XRayDate.ToString("dd.MM.yyyy")</small>
                                                    <br/>
                                                    <small>Категория: @exam.Category | Снимков: @exam.XRayShots | 
                                                        Доза: @exam.XRayDose мЗв</small>
                                                </div>
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-outline-primary me-2" 
                                                    @onclick="() => EditExistingExam(exam)">
                                                        Редактировать
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    @onclick="() => ConfirmDeleteExam(exam)">
                                                        Удалить
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                У пациента пока нет исследований. Добавьте первое исследование.
                            </div>
                        }

                        <!-- Форма для нового/редактируемого исследования -->
                        @if (showExamForm)
                        {
                            <div class="border rounded p-3 mb-3 bg-light">
                                <h6>@(editingExamId.HasValue ? "Редактирование исследования" : "Новое исследование")</h6>
                                <EditForm Model="currentExam" OnValidSubmit="SaveExam">
                                    <DataAnnotationsValidator />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label class="form-label">Название исследования *</label>
                                                <InputText class="form-control" @bind-Value="currentExam.XRayName" />
                                                <ValidationMessage For="() => currentExam.XRayName" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Дата исследования *</label>
                                                <InputDate class="form-control" @bind-Value="currentExam.XRayDate" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Категория *</label>
                                                <InputSelect class="form-select" @bind-Value="currentExam.Category">
                                                    <option value="Другое">Другое</option>
                                                    <option value="ОМС">ОМС</option>
                                                    <option value="ВМП ОМС">ВМП ОМС</option>
                                                    <option value="ДМС">ДМС</option>
                                                    <option value="ИД ФЛ">ИД ФЛ</option>
                                                    <option value="ИД ЮЛ">ИД ЮЛ</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Снимков/серий</label>
                                                <InputNumber class="form-control" @bind-Value="currentExam.XRayShots" min="0" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Доза (мЗв)</label>
                                                <InputNumber class="form-control" @bind-Value="currentExam.XRayDose" step="0.001" min="0" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Модальность</label>
                                                <InputSelect class="form-select" @bind-Value="currentExam.XRayModality">
                                                    <option value="">-- Выберите --</option>
                                                    <option value="Цифровая рентгенография">Цифровая рентгенография</option>
                                                    <option value="Аналоговая рентгенография">Аналоговая рентгенография</option>
                                                    <option value="КТ">КТ</option>
                                                    <option value="МРТ">МРТ</option>
                                                    <option value="УЗИ">УЗИ</option>
                                                    <option value="Маммография">Маммография</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Стоимость</label>
                                                <InputNumber class="form-control" @bind-Value="currentExam.XRayCost" min="0" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Врач</label>
                                                <InputText class="form-control" @bind-Value="currentExam.Doctor" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Лаборант</label>
                                                <InputText class="form-control" @bind-Value="currentExam.Laborant" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Диагноз</label>
                                                <InputText class="form-control" @bind-Value="currentExam.XRayDiagnose" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="currentExam.XRayPatology" />
                                                <label class="form-check-label">Патология</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="currentExam.InOperation" />
                                                <label class="form-check-label">В операционной</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <InputCheckbox class="form-check-input" @bind-Value="currentExam.Contrast" />
                                                <label class="form-check-label">Контраст</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Сторона</label>
                                                <InputSelect class="form-select" @bind-Value="currentExam.Side">
                                                    <option value="">-- Выберите --</option>
                                                    <option value="Правая">Правая</option>
                                                    <option value="Левая">Левая</option>
                                                    <option value="Нет">Нет</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Область исследования</label>
                                                <InputSelect class="form-select" @bind-Value="currentExam.Area">
                                                    <option value="">-- Выберите --</option>
                                                    <option value=10>Голова</option>
                                                    <option value=20>Шея</option>
                                                    <option value=30>Грудь</option>
                                                    <option value=40>Живот</option>
                                                    <option value=50>Конечности</option>
                                                    <option value=60>Таз</option>
                                                    <option value=70>Позвоночник</option>
                                                    <option value=80>Плод</option>
                                                    <option value=90>Всё тело</option>
                                                    <option value=0>Прочее</option>
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <button type="button" class="btn btn-secondary" @onclick="CancelExamEdit">Отмена</button>
                                        <button type="submit" class="btn btn-primary">Сохранить исследование</button>
                                    </div>
                                </EditForm>
                            </div>
                        }

                        <!-- Кнопка добавления нового исследования -->
                        @if (!showExamForm)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="AddNewExam">
                                <i class="bi bi-plus-circle"></i> 
                                Добавить новое исследование
                            </button>
                        }
                        @if (existingPatientId == 0)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i>
                                Сначала сохраните данные пациента
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Закрыть</button>
                @if (existingRecordId > 0)
                {
                    <button type="button" class="btn btn-success" @onclick="SaveFullRecord">
                        Сохранить запись
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Диалог удаления исследования -->
    @if (showDeleteDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Подтверждение удаления</h5>
                        <button type="button" class="btn-close" @onclick="CancelDeleteExam"></button>
                    </div>
                    <div class="modal-body">
                        <p>@deleteDialogMessage</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeleteExam">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteExamConfirmed">Удалить</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Диалог удаления пациента -->
    @if (showDeletePatientDialog)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">
                            <i class="bi bi-exclamation-triangle"></i> Подтверждение удаления пациента
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDeletePatient"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <h6>Внимание! Это действие нельзя отменить.</h6>
                            <p>Будут удалены:</p>
                            <ul>
                                <li>Пациент: <strong>
                                        @FormModel.Patient.SecondName 
                                        @FormModel.Patient.FirstName 
                                        @FormModel.Patient?.ThirdName
                                    </strong></li>
                                <li>Номер карты: <strong>@FormModel.Patient.MedNumber</strong></li>
                                <li>Все связанные исследования: <strong>@existingExams?.Count</strong></li>
                            </ul>
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="confirmPatientDelete" />
                            <label class="form-check-label">
                                Я подтверждаю удаление пациента и всех связанных данных
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeletePatient">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="DeletePatientConfirmed" 
                        disabled="@(!confirmPatientDelete)">
                            <i class="bi bi-trash"></i> Удалить пациента
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public int? RecordId { get; set; }

    [Parameter]
    public int CurrentCabinetId { get; set; }

    [Parameter]
    public int CurrentUserId { get; set; }

    private string activeTab = "patient";

    private RecordInputModel FormModel = new();

    private int existingRecordId = 0;
    private int existingPatientId = 0;

    private List<XRayExamOutputModel> existingExams = new();

    // Поля для управления формой исследования
    private bool showExamForm = false;
    private int? editingExamId = null;
    private XRayExamInputModel currentExam = new ();

    // Поля для диалога удаления
    private bool showDeleteDialog = false;
    private string deleteDialogMessage = "";
    private int? examToDeleteId = null;
    //private XRayExamOutputModel examToDelete;

    // Поля для диалога удаления пациента
    private bool showDeletePatientDialog = false;
    private bool confirmPatientDelete = false;

    //Поле сегодняшней даты
    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    //Поля пользователя
    private string currentUserFIO = string.Empty;

    private string Title => existingRecordId > 0 ? "Редактирование записи" : "Новая запись";

    protected override async Task OnInitializedAsync()
    {

        FormModel.Patient.BirthDate = today;

        await LoadData();
    }

    private async Task LoadData()
    {
        if (RecordId.HasValue && RecordId.Value > 0)
        {
            // Режим редактирования существующей записи
            var result = await RecordService.GetByIdAsync(RecordId.Value);
            if (result.Success && result.Data != null)
            {
                existingRecordId = result.Data.Id;
                existingPatientId = result.Data.Patient.Id;

                FormModel = new RecordInputModel
                {
                    Date = result.Data.Date,
                    Patient = new PatientInputModel
                    {
                        Id = result.Data.Patient.Id,
                        SecondName = result.Data.Patient.SecondName,
                        FirstName = result.Data.Patient.FirstName,
                        ThirdName = result.Data.Patient.ThirdName,
                        BirthDate = result.Data.Patient.BirthDate,
                        Sex = result.Data.Patient.Sex,
                        MedNumber = result.Data.Patient.MedNumber
                    },
                    Exam = new XRayExamInputModel
                    {
                        Id = result.Data.Exam.Id,
                        XRayName = result.Data.Exam.XRayName,
                        XRayDose = result.Data.Exam.XRayDose,
                        XRayShots = result.Data.Exam.XRayShots,
                        XRayDate = result.Data.Exam.XRayDate,
                        Category = result.Data.Exam.Category,
                        XRayDiagnose = result.Data.Exam.XRayDiagnose,
                        XRayPatology = result.Data.Exam.XRayPatology,
                        XRayCost = result.Data.Exam.XRayCost,
                        Doctor = result.Data.Exam.Doctor,
                        Laborant = result.Data.Exam.Laborant,
                        XRayModality = result.Data.Exam.XRayModality,
                        InOperation = result.Data.Exam.InOperation,
                        Contrast = result.Data.Exam.Contrast,
                        CabinetId = result.Data.Exam.CabinetId,
                        Side = result.Data.Exam.Side,
                        Area = result.Data.Exam.Area
                    },
                    Number = new NumberInputModel
                    {
                        Id = result.Data.Number.Id,
                        YearlyNum = result.Data.Number.YearlyNum,
                        DailyNum = result.Data.Number.DailyNum
                    }
                };
                // Загрузка всех исследований пациента
                await LoadPatientExams(existingPatientId);
            }
        }
        else
        {
            // Режим добавления новой записи
            FormModel = new RecordInputModel
            {
                Date = DateOnly.FromDateTime(DateTime.Now),
                Patient = new PatientInputModel(),
                Exam = new XRayExamInputModel
                {
                    XRayDate = DateOnly.FromDateTime(DateTime.Now)
                },
                Number = new NumberInputModel()
            };
        }
    }

    private async Task LoadPatientExams(int patientId)
    {
        var result = await XRayExamService.GetByPatientIdAsync(patientId);
        if (result.Success)
        {
            existingExams = result.Data;
        }
    }

    private async Task CloseModal()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task AddNewExam()
    {
        editingExamId = null;

        var user = await UserService.GetByIdAsync(CurrentUserId);
        string doctorName = null; //Для хранения ФИО врача
        string laborantName = null; //Для хранения ФИО лаборанта

        if (user.Success && user.Data != null)
        {
            currentUserFIO = user.Data.FIOshort;
            //Присваиваем ФИО в зависимости от авторизованной роли
            if (user.Data.Role.ToString() == "Doctor")
            {
                doctorName = currentUserFIO;
            }else if(user.Data.Role.ToString() == "Laborant")
            {
                laborantName = currentUserFIO;
            }
        }
        currentExam = new XRayExamInputModel
            {
                Category = "Другое",
                CabinetId = CurrentCabinetId,
                XRayDate = today,
                Doctor = doctorName,
                Laborant = laborantName,
            }; //XRayJournal.Core.Results.OperationResult<T>.Data.get вернул null.

        showExamForm = true;
    }

    private void EditExistingExam(XRayExamOutputModel exam)
    {

        editingExamId = exam.Id;
        currentExam = new XRayExamInputModel
            {
                Id = exam.Id,
                XRayName = exam.XRayName,
                XRayDose = exam.XRayDose,
                XRayShots = exam.XRayShots,
                XRayDate = exam.XRayDate,
                Category = exam.Category,
                XRayDiagnose = exam.XRayDiagnose,
                XRayPatology = exam.XRayPatology,
                XRayCost = exam.XRayCost,
                Doctor = exam.Doctor,
                Laborant = exam.Laborant,
                XRayModality = exam.XRayModality,
                InOperation = exam.InOperation,
                Contrast = exam.Contrast,
                CabinetId = exam.CabinetId,
                Side = exam.Side,
                Area = exam.Area
            };
        showExamForm = true;
    }

    private void CancelExamEdit()
    {
        showExamForm = false;
        editingExamId = null;
        currentExam = new ();
        StateHasChanged();
    }

    private async Task SaveExam()
    {
        // Обновляем список исследований пациента
        if (editingExamId.HasValue)
        {
            // Обновление существующего исследования
            var result = XRayExamService.Update(currentExam);
            if (result.Success)
            {
                await LoadPatientExams(existingPatientId);
                await JS.InvokeVoidAsync("alert", "Исследование обновлено");
            }
        }
        else
        {
            // Добавление нового исследования
            var result = XRayExamService.Add(currentExam);
            if (result.Success)
            {
                await LoadPatientExams(existingPatientId);
                await JS.InvokeVoidAsync("alert", "Исследование добавлено");
            }
        }
        CancelExamEdit();
    }

    private void ConfirmDeleteExam(XRayExamOutputModel exam)
    {
        examToDeleteId = exam.Id;
        deleteDialogMessage = $"Вы уверены, что хотите удалить исследование '{exam.XRayName}' от {exam.XRayDate.ToString("dd.MM.yyyy")}?";
        showDeleteDialog = true;
        StateHasChanged();
    }

    private void CancelDeleteExam()
    {
        showDeleteDialog = false;
        examToDeleteId = null;
        StateHasChanged();
    }

    private async Task DeleteExamConfirmed()
    {
        if (examToDeleteId == null)
        {
            Console.WriteLine("examToDeleteId is null!");
            return; 
        }
        try
        {
            var result = XRayExamService.Delete(examToDeleteId.Value);

            if (result.Success)
            {
                await LoadPatientExams(existingPatientId);
                await JS.InvokeVoidAsync("alert", "Исследование удалено");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при удалении исследования: {ex.Message}");
        }
        finally
        {
            CancelDeleteExam();
        }
    }

    private void ShowDeletePatientModal()
    {
        showDeletePatientDialog = true;
        confirmPatientDelete = false;
        StateHasChanged();
    }

    private void CancelDeletePatient()
    {
        showDeletePatientDialog = false;
        confirmPatientDelete = false;
        StateHasChanged();
    }

    private async Task DeletePatientConfirmed()
    {
        try
        {
            var result = PatientService.Delete(existingPatientId);

            if (result.Success)
            {
                await JS.InvokeVoidAsync("alert", "Пациент удалён");
                await CloseModal();
                if (OnSave.HasDelegate)
                {
                    await OnSave.InvokeAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при удалении пациента: {ex.Message}");
        }
        finally
        {
            CancelDeletePatient();
        }
    }

    private void SwitchToPatientTab()
    {
        activeTab = "patient";
        StateHasChanged();
    }

    private async Task SaveFullRecord()
    {
        // Проверка, что пациент сохранён
        if (existingPatientId == 0)
        {
            await JS.InvokeVoidAsync("alert", "Сначала сохраните данные пациента!");
            return;
        }
        // Получаем текущего пользователя
        var result = await RecordService.CreateRecordAsync(FormModel, CurrentUserId, CurrentCabinetId);
        if (result.Success)
        {
            await JS.InvokeVoidAsync("alert", "Запись сохранена");
            if (OnSave.HasDelegate)
            {
                await OnSave.InvokeAsync();
            }
            await CloseModal();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка: {result.ErrorMessage}");
        }
    }

    private async Task SavePatientOnly()
    {
        if (existingPatientId > 0)
        {
            // Обновление существующего пациента
            var result = PatientService.Update(FormModel.Patient);
            if (result.Success)
            {
                existingPatientId = result.Data.Id;
                await JS.InvokeVoidAsync("alert", "Данные пациента сохранены");
            }
        }
        else
        {
            // Создание нового пациента
            var result = PatientService.Add(FormModel.Patient);
            if (result.Success)
            {
                existingPatientId = result.Data.Id;
                FormModel.Patient.Id = existingPatientId;
                await JS.InvokeVoidAsync("alert", "Пациент создан");
            }
        }

        // После успешного сохранения пациента, переключаемся на исследования
        activeTab = "exams";
        StateHasChanged();
    }
}

